<div class="row" style="flex-wrap: nowrap; --gap: 2px">
    @if (string.IsNullOrWhiteSpace(Value))
    {
        <span class="muted" style="min-height: 32px; display: flex; align-items: center">@Missing</span>
    }
    else
    {
        <span class="grow wrap-any @(Mono ? "mono smaller" : "")">@Value</span>
        <CopyButton Value="@Value" Label="@Label" />
    }
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter, EditorRequired] public string Missing { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public bool Mono { get; set; }
}
