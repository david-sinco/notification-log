@inject ListingsApiClient Api

<section class="card" aria-label="Fotos" style="--gap: 16px">
    <div class="row row-between row-bottom" style="--gap: 12px">
        <div class="stack grow" style="--gap: 2px; --basis: 260px">
            <h2 class="h2">Fotos</h2>
            <span class="small muted">
                @order.Count de @ListingLimits.MaxPhotos · mínimo @ListingLimits.MinPhotos para enviar a revisión.
                @(CanEdit ? "Arrastra para ordenar o usa las flechas; la primera es la portada." : "La primera es la portada.")
            </span>
        </div>
        @if (CanEdit)
        {
            <label class="btn btn-sm btn-file">
                Agregar fotos
                <InputFile multiple accept="image/jpeg,image/png,image/webp" disabled="@busy" OnChange="UploadAsync" />
            </label>
        }
    </div>

    @if (order.Count == 0)
    {
        <EmptyState Text="Sin fotos todavía. JPEG, PNG o WebP de hasta 10 MB." />
    }
    else
    {
        <ul class="grid-fill">
            @for (var i = 0; i < order.Count; i++)
            {
                var index = i;
                var photo = order[i];
                <li class="photo @PhotoClass(index)" @key="photo.FileName"
                    draggable="@(CanEdit ? "true" : "false")"
                    @ondragstart="() => dragging = index"
                    @ondragend="EndDrag"
                    @ondragover:preventDefault
                    @ondragover="() => { }"
                    @ondragenter="() => over = index"
                    @ondrop="() => Drop(index)">
                    <div class="photo-frame">
                        <img src="@photo.Url" alt="Foto @(index + 1)" draggable="false" />
                        <span class="photo-badge @(index == 0 ? "photo-badge-cover" : "")">@(index == 0 ? "Portada" : (index + 1).ToString())</span>
                    </div>
                    @if (CanEdit)
                    {
                        <div class="photo-actions">
                            <button type="button" aria-label="Mover la foto @(index + 1) antes" disabled="@(index == 0)" @onclick="() => Move(index, index - 1)">←</button>
                            <button type="button" aria-label="Mover la foto @(index + 1) después" disabled="@(index == order.Count - 1)" @onclick="() => Move(index, index + 1)">→</button>
                            <button type="button" aria-label="Quitar la foto @(index + 1)" disabled="@busy" @onclick="() => RemoveAsync(photo.FileName)">Quitar</button>
                        </div>
                    }
                </li>
            }
        </ul>
    }

    @if (message is not null)
    {
        <div class="note note-warning" role="status"><span>@message</span></div>
    }

    <ErrorAlert Exception="error" />

    @if (CanEdit && order.Count > 1)
    {
        <div class="save-bar @(MovedCount > 0 ? "dirty" : "")" aria-live="polite">
            <span>@SaveText</span>
            <div class="row" style="--gap: 8px">
                <button type="button" class="btn btn-sm btn-ghost" disabled="@(MovedCount == 0 || busy)" @onclick="Discard">Descartar</button>
                <button type="button" class="btn btn-sm btn-lime" disabled="@(MovedCount == 0 || busy)" @onclick="SaveOrderAsync">Guardar orden</button>
            </div>
        </div>
    }
</section>

@code {
    private const long MaxPhotoBytes = 10 * 1024 * 1024;

    private List<ListingPhotoDto> order = [];
    private IReadOnlyList<ListingPhotoDto> saved = [];
    private bool busy;
    private bool justSaved;
    private int? dragging;
    private int? over;
    private string? message;
    private ApiException? error;

    [Parameter, EditorRequired] public Guid ListingId { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<ListingPhotoDto> Photos { get; set; } = [];
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private int MovedCount => order.Where((photo, index) => saved[index].FileName != photo.FileName).Count();

    private string SaveText => MovedCount > 0
        ? $"{MovedCount} fotos cambiaron de posición. Guarda para actualizar el orden."
        : justSaved ? "Orden guardado. Así se verá en el catálogo." : "El orden coincide con el guardado.";

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(saved, Photos))
            return;

        saved = Photos;
        order = [.. Photos];
    }

    private string PhotoClass(int index) =>
        dragging == index ? "dragging"
        : over == index && dragging is not null ? "over"
        : saved[index].FileName != order[index].FileName ? "moved" : "";

    private void Move(int from, int to)
    {
        var photo = order[from];
        order.RemoveAt(from);
        order.Insert(to, photo);
        justSaved = false;
    }

    private void Drop(int target)
    {
        if (dragging is { } source && source != target)
            Move(source, target);

        EndDrag();
    }

    private void EndDrag()
    {
        dragging = null;
        over = null;
    }

    private void Discard() => order = [.. saved];

    private Task SaveOrderAsync() => RunAsync(async () =>
    {
        await Api.ReorderPhotosAsync(
            ListingId, new ReorderListingPhotosRequest(order.Select(photo => photo.FileName).ToList()), CancellationToken.None);
        justSaved = true;
    });

    private Task UploadAsync(InputFileChangeEventArgs e) => RunAsync(async () =>
    {
        foreach (var file in e.GetMultipleFiles(ListingLimits.MaxPhotos))
        {
            if (file.Size > MaxPhotoBytes)
            {
                message = $"«{file.Name}» supera los 10 MB y no se subió.";
                continue;
            }

            await using var content = file.OpenReadStream(MaxPhotoBytes);
            await Api.AddPhotoAsync(ListingId, content, file.Name, CancellationToken.None);
        }
    });

    private Task RemoveAsync(string fileName) =>
        RunAsync(() => Api.RemovePhotoAsync(ListingId, fileName, CancellationToken.None));

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        message = null;
        try
        {
            await action();
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            busy = false;
            await OnChanged.InvokeAsync();
        }
    }
}
