@using System.Security.Claims

<AuthorizeView>
    <Authorized>
        <div class="nav-user">
            <a class="nav-user-identity" href="users/me">
                <span class="nav-user-avatar" aria-hidden="true">@Initials(context.User)</span>
                <span>
                    <span class="nav-user-name">@(context.User.Identity?.Name ?? "Mi cuenta")</span>
                    <span class="nav-user-role">@Roles(context.User)</span>
                </span>
            </a>

            <form action="authentication/logout" method="post">
                <AntiforgeryToken />
                <input type="hidden" name="returnUrl" value="/" />
                <button type="submit" class="nav-logout">Salir</button>
            </form>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private static string Initials(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name;

        if (string.IsNullOrWhiteSpace(name))
            return "·";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length == 1
            ? parts[0][..1].ToUpperInvariant()
            : $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string Roles(ClaimsPrincipal user)
    {
        var roles = user.FindAll(IdentityClaims.Role).Select(claim => claim.Value).ToArray();

        return roles.Length == 0 ? "Sin rol" : string.Join(" · ", roles);
    }
}
