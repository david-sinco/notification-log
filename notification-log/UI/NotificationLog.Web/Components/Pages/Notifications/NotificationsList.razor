@page "/notifications"
@inject NotificationsApiClient Api
@inject TemplatesApiClient TemplatesApi
@inject RecipientsApiClient RecipientsApi

<PageTitle>Envíos · Llave</PageTitle>

<div class="page">
    <header class="page-head">
        <p class="eyebrow">Notificaciones</p>
        <h1 class="title">Envíos</h1>
        <p class="muted">Registro inmutable de cada intento. Nada se descarta en silencio: un fallo también queda escrito.</p>
    </header>

    <ErrorAlert Exception="error" />

    <section class="row" aria-label="Filtros">
        <label class="sr-only" for="event-search">Buscar por evento o destino</label>
        <input id="event-search" type="search" class="input input-search grow" style="--basis: 220px" placeholder="Evento o destino"
               @bind="search" @bind:after="RefreshAsync" />
        <div class="segmented" role="group" aria-label="Estado">
            <button type="button" aria-pressed="@(statusFilter is null ? "true" : "false")" @onclick="() => SetStatusAsync(null)">Todos · @(sentCount + failedCount)</button>
            <button type="button" aria-pressed="@(statusFilter == DeliveryStatus.Sent ? "true" : "false")" @onclick="() => SetStatusAsync(DeliveryStatus.Sent)">Enviados · @sentCount</button>
            <button type="button" aria-pressed="@(statusFilter == DeliveryStatus.Failed ? "true" : "false")" @onclick="() => SetStatusAsync(DeliveryStatus.Failed)">Fallidos · @failedCount</button>
        </div>
        <div class="chips" role="group" aria-label="Canal" style="gap: 6px">
            <button type="button" class="chip" aria-pressed="@(channelFilter is null ? "true" : "false")" @onclick="() => SetChannelAsync(null)">Todos los canales</button>
            @foreach (var channel in Enum.GetValues<NotificationChannel>())
            {
                <button type="button" class="chip" aria-pressed="@(channelFilter == channel ? "true" : "false")" @onclick="() => SetChannelAsync(channel)">@ChannelLabels.Name(channel.ToString())</button>
            }
        </div>
    </section>

    @if (page is { Items.Count: 0 })
    {
        <EmptyState Text="Ningún envío coincide con estos filtros." />
    }
    else if (page is not null)
    {
        <section class="stack" aria-label="Historial" style="--gap: 8px">
            @foreach (var notification in page.Items)
            {
                var sent = notification.Status == nameof(DeliveryStatus.Sent);
                var open = opened == notification.Id;
                <article class="send @(open ? "open" : "")">
                    <button type="button" class="send-head" aria-expanded="@(open ? "true" : "false")" @onclick="() => ToggleAsync(notification)">
                        <span class="dot @(sent ? "" : "dot-danger")" aria-hidden="true"></span>
                        <span class="event-key" style="flex: 2 1 180px; min-width: 0">@notification.EventKey</span>
                        <ChannelBadge Channel="@notification.Channel" />
                        <span class="wrap-any" style="flex: 2 1 180px; min-width: 0">@notification.Destination</span>
                        <span class="smaller strong @(sent ? "text-success" : "text-danger")">@(sent ? "Enviado" : "Falló")</span>
                        <span class="smaller muted">@Occurred(notification)</span>
                    </button>
                    @if (open)
                    {
                        <div class="send-body">
                            @if (!sent)
                            {
                                <div class="note note-danger" role="alert">
                                    <strong>Motivo del fallo</strong>
                                    <span class="mono wrap-any">@notification.Error</span>
                                </div>
                            }
                            <div class="grid-auto">
                                <div class="fact"><span class="fact-label">Destinatario</span><span class="fact-value">@(recipientName ?? "Sin destinatario registrado")</span></div>
                                <div class="fact"><span class="fact-label">Plantilla y versión</span><span class="fact-value">@(templateLabel ?? "Sin plantilla")</span></div>
                                <div class="fact"><span class="fact-label">Id del proveedor</span><span class="fact-value">@(notification.ProviderMessageId ?? (sent ? "El proveedor no devolvió id" : "Sin id: no salió"))</span></div>
                                <div class="fact"><span class="fact-label">Ocurrió</span><span class="fact-value">@Occurred(notification)</span></div>
                            </div>
                            @if (notification.Payload is { Count: > 0 })
                            {
                                <div class="stack" style="--gap: 6px">
                                    <span class="fact-label">Datos del evento</span>
                                    <div class="row" style="--gap: 6px">
                                        @foreach (var (key, value) in notification.Payload)
                                        {
                                            <span class="tag"><span class="muted">@key</span><span>@value</span></span>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="row" style="--gap: 16px">
                                <a class="link" href="templates/@notification.TemplateId">Ver plantilla</a>
                                @if (notification.RecipientId is { } recipientId)
                                {
                                    <a class="link" href="recipients/@recipientId">Ver destinatario</a>
                                }
                                <a class="link" href="triggers">Ver triggers</a>
                            </div>
                        </div>
                    }
                </article>
            }
        </section>

        <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" Shown="page.Items.Count" Noun="envíos" OnPageChange="GoToPageAsync" />
    }
</div>

@code {
    private const int PageSize = 10;

    private PagedResult<NotificationDto>? page;
    private int sentCount;
    private int failedCount;
    private ApiException? error;

    private string search = "";
    private DeliveryStatus? statusFilter;
    private NotificationChannel? channelFilter;
    private int currentPage = 1;

    private Guid? opened;
    private string? recipientName;
    private string? templateLabel;

    private string? SearchTerm => string.IsNullOrWhiteSpace(search) ? null : search;

    protected override Task OnInitializedAsync() => LoadAsync();

    private static string Occurred(NotificationDto notification) =>
        RentalsFormat.Moment(new DateTimeOffset(DateTime.SpecifyKind(notification.OccurredAt, DateTimeKind.Utc)));

    private async Task LoadAsync()
    {
        try
        {
            var none = CancellationToken.None;
            var pageTask = Api.ListAsync(null, SearchTerm, statusFilter, channelFilter, currentPage, PageSize, none);
            var sentTask = Api.ListAsync(null, SearchTerm, DeliveryStatus.Sent, channelFilter, 1, 1, none);
            var failedTask = Api.ListAsync(null, SearchTerm, DeliveryStatus.Failed, channelFilter, 1, 1, none);
            await Task.WhenAll(pageTask, sentTask, failedTask);

            page = pageTask.Result;
            sentCount = sentTask.Result.TotalCount;
            failedCount = failedTask.Result.TotalCount;
            opened = null;
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task SetStatusAsync(DeliveryStatus? status)
    {
        statusFilter = status;
        return RefreshAsync();
    }

    private Task SetChannelAsync(NotificationChannel? channel)
    {
        channelFilter = channel;
        return RefreshAsync();
    }

    private Task GoToPageAsync(int target)
    {
        currentPage = target;
        return LoadAsync();
    }

    private async Task ToggleAsync(NotificationDto notification)
    {
        if (opened == notification.Id)
        {
            opened = null;
            return;
        }

        opened = notification.Id;
        recipientName = null;
        templateLabel = null;

        try
        {
            var template = await TemplatesApi.GetByIdAsync(notification.TemplateId, CancellationToken.None);
            var version = template.History.FirstOrDefault(candidate => candidate.Id == notification.TemplateVersionId);
            templateLabel = version is null ? template.Name : $"{template.Name} · v{version.Number}";

            if (notification.RecipientId is { } recipientId)
                recipientName = (await RecipientsApi.GetByIdAsync(recipientId, CancellationToken.None)).Name;
        }
        catch (ApiException)
        {
        }
    }
}
