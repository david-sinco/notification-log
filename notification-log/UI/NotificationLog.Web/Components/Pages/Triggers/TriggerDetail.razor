@page "/triggers/{Id:guid}"
@inject TriggersApiClient TriggersApi
@inject TemplatesApiClient TemplatesApi

<PageTitle>Trigger · NotificationLog</PageTitle>

<div class="mb-3">
    <a href="/triggers" class="small">← Volver a triggers</a>
</div>

@if (loading)
{
    <div class="p-5 text-center text-muted">Cargando…</div>
}
else if (loadError is not null)
{
    <ErrorAlert Exception="loadError" />
}
else if (trigger is not null)
{
    <div class="page-header">
        <div>
            <h1><code>@trigger.EventKey</code></h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <StatusPill Text="@(trigger.IsEnabled ? "Habilitado" : "Deshabilitado")"
                        Variant="@(trigger.IsEnabled ? "success" : "neutral")" />
            <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="ToggleStatusAsync">
                @(trigger.IsEnabled ? "Deshabilitar" : "Habilitar")
            </button>
        </div>
    </div>

    @if (actionError is not null)
    {
        <ErrorAlert Exception="actionError" />
    }

    <div class="surface-card mb-4">
        <h2 class="h6">Descripción</h2>
        <div class="d-flex gap-2 align-items-start flex-wrap">
            <textarea class="form-control" style="min-width:280px;flex:1" rows="2" @bind="descriptionDraft"></textarea>
            <button class="btn btn-primary" disabled="@(busy || descriptionDraft == trigger.Description)"
                    @onclick="SaveDescriptionAsync">
                Guardar
            </button>
        </div>
    </div>

    <div class="table-card mb-4">
        <div class="d-flex justify-content-between align-items-center px-3 pt-3 pb-2">
            <h2 class="h6 mb-0">Configuraciones de notificación</h2>
            <button class="btn btn-sm btn-primary" @onclick="OpenAddConfiguration">+ Agregar configuración</button>
        </div>

        @if (trigger.Configurations.Count == 0)
        {
            <EmptyState Text="Este trigger todavía no tiene canales configurados." Icon="⚙️" />
        }
        else
        {
            <div class="table-responsive-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Canal</th>
                            <th>Plantilla</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in trigger.Configurations)
                        {
                            <tr>
                                <td><ChannelBadge Channel="@c.Channel" /></td>
                                <td>
                                    <a href='@($"/templates/{c.TemplateId}")'>@TemplateName(c.TemplateId)</a>
                                </td>
                                <td>
                                    <StatusPill Text="@(c.IsEnabled ? "Habilitada" : "Deshabilitada")"
                                                Variant="@(c.IsEnabled ? "success" : "neutral")" />
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" disabled="@busy"
                                                @onclick="() => OpenChangeTemplate(c)">
                                            Cambiar plantilla
                                        </button>
                                        @if (c.IsEnabled)
                                        {
                                            <button class="btn btn-outline-secondary" disabled="@busy"
                                                    @onclick="() => DisableConfigurationAsync(c.Id)">
                                                Deshabilitar
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-outline-secondary" disabled="@busy"
                                                    @onclick="() => EnableConfigurationAsync(c.Id)">
                                                Habilitar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<Modal Title="Agregar configuración" @bind-IsVisible="showAddConfiguration">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">Canal</label>
            <select class="form-select" @bind="newConfigChannel" @bind:after="RefreshTemplatesForChannel">
                <option value="Email">Email</option>
                <option value="Sms">SMS</option>
                <option value="Push">Push</option>
                <option value="WhatsApp">WhatsApp</option>
            </select>
        </div>
        <div class="mb-1">
            <label class="form-label">Plantilla</label>
            <select class="form-select" @bind="newConfigTemplateId">
                <option value="">Seleccioná una plantilla…</option>
                @foreach (var t in templatesForChannel)
                {
                    <option value="@t.Id">@t.Name (v@(t.CurrentVersion))</option>
                }
            </select>
            @if (templatesForChannel.Count == 0)
            {
                <div class="form-hint">No hay plantillas habilitadas para este canal. Creá una primero en Plantillas.</div>
            }
        </div>
        @if (addConfigError is not null)
        {
            <div class="mt-3">
                <ErrorAlert Exception="addConfigError" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showAddConfiguration = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(addingConfig || newConfigTemplateId == Guid.Empty)"
                @onclick="AddConfigurationAsync">
            Agregar
        </button>
    </FooterContent>
</Modal>

<Modal Title="Cambiar plantilla" @bind-IsVisible="showChangeTemplate">
    <ChildContent>
        @if (configBeingChanged is not null)
        {
            <p class="text-muted small">
                Canal: <ChannelBadge Channel="@configBeingChanged.Channel" /> ·
                Plantilla actual: <strong>@TemplateName(configBeingChanged.TemplateId)</strong>
            </p>
        }
        <div class="mb-1">
            <label class="form-label">Nueva plantilla</label>
            <select class="form-select" @bind="changeTemplateTargetId">
                <option value="">Seleccioná una plantilla…</option>
                @foreach (var t in templatesForChangeChannel)
                {
                    <option value="@t.Id">@t.Name (v@(t.CurrentVersion))</option>
                }
            </select>
            @if (templatesForChangeChannel.Count == 0)
            {
                <div class="form-hint">No hay otras plantillas habilitadas para este canal.</div>
            }
        </div>
        @if (changeTemplateError is not null)
        {
            <div class="mt-3">
                <ErrorAlert Exception="changeTemplateError" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showChangeTemplate = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(changingTemplate || changeTemplateTargetId == Guid.Empty)"
                @onclick="ChangeTemplateAsync">
            Cambiar
        </button>
    </FooterContent>
</Modal>

@code {
    [Parameter] public Guid Id { get; set; }

    private TriggerDto? trigger;
    private bool loading = true;
    private ApiException? loadError;
    private ApiException? actionError;
    private bool busy;

    private string descriptionDraft = "";

    private IReadOnlyList<TemplateSummaryDto> allTemplates = [];
    private Dictionary<Guid, string> templateNames = new();

    private bool showAddConfiguration;
    private bool addingConfig;
    private ApiException? addConfigError;
    private NotificationChannel newConfigChannel = NotificationChannel.Email;
    private Guid newConfigTemplateId = Guid.Empty;
    private List<TemplateSummaryDto> templatesForChannel = [];

    private bool showChangeTemplate;
    private bool changingTemplate;
    private ApiException? changeTemplateError;
    private ConfigurationDto? configBeingChanged;
    private Guid changeTemplateTargetId = Guid.Empty;
    private List<TemplateSummaryDto> templatesForChangeChannel = [];

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            var triggerTask = TriggersApi.GetByIdAsync(Id, CancellationToken.None);
            var templatesTask = TemplatesApi.ListAsync(null, null, null, 1, 200, CancellationToken.None);
            await Task.WhenAll(triggerTask, templatesTask);

            trigger = triggerTask.Result;
            descriptionDraft = trigger.Description;
            allTemplates = templatesTask.Result.Items;
            templateNames = allTemplates.ToDictionary(t => t.Id, t => t.Name);
            loadError = null;
        }
        catch (ApiException ex)
        {
            loadError = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private string TemplateName(Guid templateId) =>
        templateNames.TryGetValue(templateId, out var name) ? name : "(plantilla eliminada)";

    private async Task ToggleStatusAsync()
    {
        if (trigger is null) return;
        busy = true;
        try
        {
            await TriggersApi.SetStatusAsync(Id, !trigger.IsEnabled, CancellationToken.None);
            await LoadAsync();
            actionError = null;
        }
        catch (ApiException ex)
        {
            actionError = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveDescriptionAsync()
    {
        busy = true;
        try
        {
            await TriggersApi.UpdateDescriptionAsync(Id, descriptionDraft, CancellationToken.None);
            await LoadAsync();
            actionError = null;
        }
        catch (ApiException ex)
        {
            actionError = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenAddConfiguration()
    {
        newConfigChannel = NotificationChannel.Email;
        addConfigError = null;
        RefreshTemplatesForChannel();
        showAddConfiguration = true;
    }

    private void RefreshTemplatesForChannel()
    {
        templatesForChannel = allTemplates
            .Where(t => t.IsEnabled && t.Channel == newConfigChannel.ToString())
            .ToList();
        newConfigTemplateId = Guid.Empty;
    }

    private async Task AddConfigurationAsync()
    {
        addingConfig = true;
        try
        {
            await TriggersApi.AddConfigurationAsync(Id, newConfigTemplateId, newConfigChannel, CancellationToken.None);
            showAddConfiguration = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            addConfigError = ex;
        }
        finally
        {
            addingConfig = false;
        }
    }

    private async Task DisableConfigurationAsync(Guid configId)
    {
        busy = true;
        try
        {
            await TriggersApi.DisableConfigurationAsync(Id, configId, CancellationToken.None);
            await LoadAsync();
            actionError = null;
        }
        catch (ApiException ex)
        {
            actionError = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task EnableConfigurationAsync(Guid configId)
    {
        busy = true;
        try
        {
            await TriggersApi.EnableConfigurationAsync(Id, configId, CancellationToken.None);
            await LoadAsync();
            actionError = null;
        }
        catch (ApiException ex)
        {
            actionError = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenChangeTemplate(ConfigurationDto config)
    {
        configBeingChanged = config;
        changeTemplateTargetId = Guid.Empty;
        changeTemplateError = null;
        templatesForChangeChannel = allTemplates
            .Where(t => t.IsEnabled && t.Channel == config.Channel && t.Id != config.TemplateId)
            .ToList();
        showChangeTemplate = true;
    }

    private async Task ChangeTemplateAsync()
    {
        if (configBeingChanged is null) return;
        changingTemplate = true;
        try
        {
            await TriggersApi.ChangeConfigurationTemplateAsync(Id, configBeingChanged.Id, changeTemplateTargetId, CancellationToken.None);
            showChangeTemplate = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            changeTemplateError = ex;
        }
        finally
        {
            changingTemplate = false;
        }
    }
}
