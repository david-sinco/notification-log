@page "/templates"
@attribute [Authorize(Roles = IdentityRoles.Administrador)]
@inject TemplatesApiClient Api

<PageTitle>Plantillas · Llave</PageTitle>

<div class="page page-wide">
    <header class="row row-between row-bottom" style="--gap: 16px">
        <div class="page-head">
            <p class="eyebrow">Notificaciones</p>
            <h1 class="title">Plantillas</h1>
            <p class="muted">Así se ve hoy lo que recibe cada destinatario. Abre una para revisar sus versiones o editarla.</p>
        </div>
        <a class="btn btn-lg btn-primary" href="templates/new">Nueva plantilla</a>
    </header>

    <ErrorAlert Exception="loadError" />

    <section class="row" aria-label="Filtros" style="--gap: 10px">
        <div class="chips" role="group" aria-label="Canal">
            <button type="button" class="chip" aria-pressed="@(channel is null ? "true" : "false")" @onclick="() => SetChannelAsync(null)">Todas</button>
            @foreach (var option in Enum.GetValues<NotificationChannel>())
            {
                <button type="button" class="chip" aria-pressed="@(channel == option ? "true" : "false")" @onclick="() => SetChannelAsync(option)">@ChannelLabels.Name(option.ToString())</button>
            }
        </div>
        <label class="sr-only" for="template-search">Buscar plantilla</label>
        <input id="template-search" type="search" class="input input-search tpl-search" placeholder="Buscar por nombre"
               @bind="search" @bind:after="RefreshAsync" />
    </section>

    @if (page is { Items.Count: 0 })
    {
        <EmptyState Text="No hay plantillas con esos filtros." />
    }

    <div class="grid-fill" style="--min: 280px; --gap: 16px">
        @foreach (var template in page?.Items ?? [])
        {
            <a class="tpl-card" href="templates/@template.Id">
                <div class="tpl-thumb">
                    @switch (template.Channel)
                    {
                        case "Email":
                            <div class="tpl-thumb-mail">
                                <span class="smaller muted">Llave · para @Camila.Name</span>
                                <span class="strong wrap-any">@Render(template.Subject)</span>
                                <span class="clamp" style="--lines: 4">@Render(template.Body)</span>
                            </div>
                            break;
                        case "Push":
                            <div class="tpl-thumb-push">
                                <span class="smaller">LLAVE · ahora</span>
                                <span class="strong">@Render(template.Subject)</span>
                                <span class="clamp" style="--lines: 2">@Render(template.Body)</span>
                            </div>
                            break;
                        default:
                            <div class="bubble bubble-light clamp" style="--lines: 5">@Render(template.Body)</div>
                            break;
                    }
                </div>
                <div class="stack" style="--gap: 8px; padding: 14px 16px 16px">
                    <span class="strong">@template.Name</span>
                    <span class="row smaller muted" style="--gap: 8px">
                        <ChannelBadge Channel="@template.Channel" />
                        <span class="mono">v@(template.CurrentVersion)</span>
                        <span>· @Published(template.PublishedAt)</span>
                        <span class="row tpl-status" style="--gap: 6px">
                            <span class="dot @(template.IsEnabled ? "" : "dot-neutral")" aria-hidden="true"></span>
                            @(template.IsEnabled ? "Habilitada" : "Deshabilitada")
                        </span>
                    </span>
                </div>
            </a>
        }
    </div>

    @if (page is { Items.Count: > 0 })
    {
        <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" Shown="page.Items.Count" Noun="plantillas" OnPageChange="GoToPageAsync" />
    }
</div>

@code {
    private const int PageSize = 12;

    private static readonly SampleRecipient Camila = SampleRecipient.All[0];

    private PagedResult<TemplateSummaryDto>? page;
    private NotificationChannel? channel;
    private string search = "";
    private int currentPage = 1;
    private ApiException? loadError;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            var term = string.IsNullOrWhiteSpace(search) ? null : search.Trim();
            page = await Api.ListAsync(term, channel, null, currentPage, PageSize, CancellationToken.None);
            loadError = null;
        }
        catch (ApiException ex)
        {
            loadError = ex;
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task SetChannelAsync(NotificationChannel? option)
    {
        channel = option;
        return RefreshAsync();
    }

    private Task GoToPageAsync(int target)
    {
        currentPage = target;
        return LoadAsync();
    }

    private static string Render(string? text) =>
        TemplateRendering.Render(TemplateRendering.ToPlainText(text ?? ""), Camila.Values);

    private static string Published(DateTime createdAt) =>
        RentalsFormat.Moment(new DateTimeOffset(DateTime.SpecifyKind(createdAt, DateTimeKind.Utc)));
}
