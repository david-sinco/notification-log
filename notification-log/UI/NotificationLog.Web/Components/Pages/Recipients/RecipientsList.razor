@page "/recipients"
@inject RecipientsApiClient Api
@inject NavigationManager Nav

<PageTitle>Destinatarios · Llave</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Notificaciones</p>
        <h1>Destinatarios</h1>
        <p>Personas o sistemas que reciben notificaciones. Se dan de alta automáticamente desde los eventos publicados.</p>
    </div>
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

<div class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label">Buscar</label>
            <input class="form-control" placeholder="Nombre, email o teléfono… (Enter para buscar)"
                   @bind="search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select class="form-select" @bind="statusFilter" @bind:after="RefreshAsync">
                <option value="">Todos</option>
                <option value="true">Activos</option>
                <option value="false">Inactivos</option>
            </select>
        </div>
        <div class="col-md-3 text-md-end">
            <button class="btn btn-outline-secondary w-100" @onclick="RefreshAsync">Filtrar</button>
        </div>
    </div>
</div>

<div class="table-card">
    @if (loading)
    {
        <div class="p-4 text-center text-muted">Cargando…</div>
    }
    else if (page is { Items.Count: 0 })
    {
        <EmptyState Text="No se encontraron destinatarios." Icon="👥" />
    }
    else if (page is not null)
    {
        <div class="table-responsive-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in page.Items)
                    {
                        <tr class="row-link" @onclick='() => Nav.NavigateTo($"/recipients/{r.Id}")'>
                            <td>@r.Name</td>
                            <td>@(r.Email ?? "—")</td>
                            <td>@(r.Phone ?? "—")</td>
                            <td>
                                <StatusPill Text="@(r.IsActive ? "Activo" : "Inactivo")"
                                            Variant="@(r.IsActive ? "success" : "neutral")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-3 pb-3">
            <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPageChange="GoToPage" />
        </div>
    }
</div>

@code {
    private PagedResult<RecipientSummaryDto>? page;
    private bool loading = true;
    private ApiException? error;

    private string search = "";
    private string statusFilter = "";
    private int currentPage = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            bool? isActive = statusFilter switch { "true" => true, "false" => false, _ => null };
            page = await Api.ListAsync(
                string.IsNullOrWhiteSpace(search) ? null : search, isActive, currentPage, 10, CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoToPage(int p)
    {
        currentPage = p;
        return LoadAsync();
    }

    private Task OnSearchKeyUp(KeyboardEventArgs e) => e.Key == "Enter" ? RefreshAsync() : Task.CompletedTask;
}
