@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error · Llave</PageTitle>

<div class="page">
    <header class="page-head">
        <p class="eyebrow">Llave</p>
        <h1 class="title">Algo salió mal</h1>
        <p class="muted">No pudimos completar la operación. Vuelve a intentarlo en un momento.</p>
    </header>

    <div class="card">
        @if (ShowRequestId)
        {
            <div class="fact">
                <span class="fact-label">Identificador de la petición</span>
                <span class="fact-value mono">@requestId</span>
            </div>
        }
        else
        {
            <p class="muted">No hay más detalles disponibles sobre este error.</p>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
