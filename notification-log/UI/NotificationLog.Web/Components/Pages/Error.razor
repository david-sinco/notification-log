@page "/Error"
@attribute [AllowAnonymous]
@using System.Diagnostics

<PageTitle>Error · Llave</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Llave</p>
        <h1>Algo salió mal</h1>
        <p>No pudimos completar la operación. Vuelve a intentarlo en un momento.</p>
    </div>
</div>

<div class="surface-card">
    @if (ShowRequestId)
    {
        <dl class="kv-list mb-0">
            <dt>Identificador de la petición</dt>
            <dd><code>@requestId</code></dd>
        </dl>
    }
    else
    {
        <p class="mb-0 text-muted">No hay más detalles disponibles sobre este error.</p>
    }
</div>

@code{
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }

    private string? requestId;
    private bool ShowRequestId => !string.IsNullOrEmpty(requestId);

    protected override void OnInitialized()
    {
        requestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
    }
}
