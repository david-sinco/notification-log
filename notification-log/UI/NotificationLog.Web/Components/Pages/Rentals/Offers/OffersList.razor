@page "/rentals/offers"
@inject OffersApiClient Api
@inject RentalsActor Actor
@inject NavigationManager Nav

<PageTitle>Ofertas · NotificationLog</PageTitle>

<div class="page-header">
    <div>
        <h1>Ofertas</h1>
        <p>Negociaciones entre interesados y publicadores. Las ofertas se hacen desde la publicación.</p>
    </div>
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

<div class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Estado</label>
            <select class="form-select" @bind="statusFilter" @bind:after="RefreshAsync">
                <option value="">Todos</option>
                @foreach (var s in RentalsFormat.Values<OfferStatus>())
                {
                    <option value="@s">@RentalsFormat.Status(s.ToString())</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="only-mine" @bind="onlyMine" @bind:after="RefreshAsync" />
                <label class="form-check-label small" for="only-mine">Solo las que hice yo</label>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-outline-secondary w-100 w-md-auto" @onclick="RefreshAsync">Filtrar</button>
        </div>
    </div>
</div>

<div class="table-card">
    @if (loading)
    {
        <div class="p-4 text-center text-muted">Cargando…</div>
    }
    else if (page is { Items.Count: 0 })
    {
        <EmptyState Text="No se encontraron ofertas." Icon="🏷️" />
    }
    else if (page is not null)
    {
        <div class="table-responsive-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Publicación</th>
                        <th>Oferente</th>
                        <th>Monto</th>
                        <th>Precio publicado</th>
                        <th>Estado</th>
                        <th>Responder antes de</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in page.Items)
                    {
                        <tr class="row-link" @onclick='() => Nav.NavigateTo($"/rentals/offers/{o.Id}")'>
                            <td><ShortId Value="o.ListingId" Href="@($"/rentals/listings/{o.ListingId}")" /></td>
                            <td><ShortId Value="o.OffererId" /></td>
                            <td>@RentalsFormat.Money(o.Amount)</td>
                            <td class="text-muted">@RentalsFormat.Money(o.ListedPrice)</td>
                            <td><RentalStatusPill Status="@o.Status" /></td>
                            <td class="text-muted small">@(RentalsFormat.IsOpenOffer(o.Status) ? RentalsFormat.Date(o.RespondBy) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-3 pb-3">
            <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPageChange="GoToPage" />
        </div>
    }
</div>

@code {
    private PagedResult<OfferSummaryDto>? page;
    private bool loading = true;
    private ApiException? error;
    private string statusFilter = "";
    private bool onlyMine;
    private int currentPage = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            page = await Api.ListAsync(
                null,
                onlyMine ? Actor.Id ?? Guid.Empty : null,
                Enum.TryParse<OfferStatus>(statusFilter, out var status) ? status : null,
                currentPage,
                10,
                CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoToPage(int p)
    {
        currentPage = p;
        return LoadAsync();
    }

}
