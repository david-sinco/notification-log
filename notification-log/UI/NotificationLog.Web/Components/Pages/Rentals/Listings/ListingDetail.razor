@page "/rentals/listings/{Id:guid}"
@inject ListingsApiClient Api
@inject VisitsApiClient VisitsApi
@inject RentalsActor Actor
@inject NavigationManager Nav

<PageTitle>Publicación · Llave</PageTitle>

<div class="page">
    <a class="link btn-start" href="rentals/listings">← Publicaciones</a>

    <ErrorAlert Exception="loadError" />

    @if (listing is not null)
    {
        <header class="stack" style="--gap: 18px">
            <div class="row row-between row-bottom" style="--gap: 16px">
                <div class="page-head">
                    <div class="row">
                        <RentalStatusPill Status="@listing.Status" Large="true" />
                        <span class="id">@RentalsFormat.Short(listing.Id) · @RentalsFormat.Term(listing.Operation)</span>
                    </div>
                    <h1 class="title title-detail">@RentalsFormat.ListingTitle(listing.Type, listing.Neighborhood, listing.City)</h1>
                </div>
                <div class="row" style="--gap: 8px">
                    @switch (listing.Status)
                    {
                        case "Draft":
                            <button type="button" class="btn btn-primary" disabled="@(busy || !Ready)" @onclick="() => RunAsync(() => Api.SubmitForReviewAsync(Id, CancellationToken.None))">Enviar a revisión</button>
                            break;
                        case "Published":
                            <button type="button" class="btn" disabled="@busy" @onclick="() => RunAsync(() => Api.PauseAsync(Id, CancellationToken.None))">Pausar</button>
                            <button type="button" class="btn" disabled="@busy" @onclick="() => RunAsync(() => Api.RenewAsync(Id, CancellationToken.None))">Renovar vigencia</button>
                            break;
                        case "Paused":
                            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => RunAsync(() => Api.ResumeAsync(Id, CancellationToken.None))">Reanudar</button>
                            break;
                        case "Expired":
                            <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => RunAsync(() => Api.RenewAsync(Id, CancellationToken.None))">Renovar vigencia</button>
                            break;
                    }
                    @if (CanWithdraw)
                    {
                        <button type="button" class="btn btn-danger" disabled="@busy" @onclick="() => Open(Panel.Withdraw)">Retirar</button>
                    }
                </div>
            </div>

            <ol class="rail" aria-label="Ciclo de vida">
                @for (var i = 0; i < RailSteps.Length; i++)
                {
                    <li class="@(i < RailIndex ? "done" : i == RailIndex ? "current" : "")">@RailSteps[i]</li>
                }
            </ol>

            @if (Note is { } note)
            {
                <div class="note note-@note.Variant" role="status">
                    <strong>@note.Title</strong>
                    <span>@note.Text</span>
                </div>
            }
        </header>

        <ErrorAlert Exception="actionError" />

        @if (panel == Panel.Withdraw)
        {
            <ReasonPanel Title="Retirar publicación" Description="La publicación deja de estar disponible. Indica el motivo."
                         ConfirmText="Retirar publicación" Busy="busy" Error="panelError"
                         OnCancel="() => Open(Panel.None)" OnConfirm="WithdrawAsync" />
        }

        @if (panel == Panel.Visit)
        {
            <SlotPicker Title="Solicitar visita" Hint="El propietario acepta una, propone otras o cancela." ConfirmText="Solicitar visita"
                        Busy="busy" Error="panelError" OnCancel="() => Open(Panel.None)" OnConfirm="RequestVisitAsync" />
        }

        <div class="split">
            <div class="stack" style="flex: 3 1 460px; --gap: 20px">
                <ListingPhotosEditor ListingId="Id" Photos="listing.Photos" CanEdit="CanEdit" OnChanged="() => LoadAsync(keepForm: true)" />

                <section class="card" aria-label="Datos del inmueble" style="--gap: 18px">
                    <div class="stack" style="--gap: 2px">
                        <h2 class="h2">Datos del inmueble</h2>
                        <span class="small muted">
                            @(listing.Status is "Published" or "Paused"
                                ? "Editar datos o fotos de una publicación visible la devuelve a revisión."
                                : CanEdit ? "Tipo, ubicación y descripción que verá quien busque inmueble." : "Esta publicación ya no admite cambios.")
                        </span>
                    </div>

                    <fieldset class="stack" disabled="@(!CanEdit || busy)" style="--gap: 18px">
                        <div class="row row-top" style="--gap: 20px">
                            <div class="stack grow" role="group" aria-label="Tipo" style="--gap: 8px; --basis: 240px">
                                <span class="label">Tipo</span>
                                <div class="choices">
                                    @foreach (var type in RentalsFormat.Values<PropertyType>())
                                    {
                                        <button type="button" class="choice" aria-pressed="@(details.Type == type ? "true" : "false")" @onclick="() => details.Type = type">@RentalsFormat.Term(type)</button>
                                    }
                                </div>
                            </div>
                            <div class="stack grow" role="group" aria-label="Estrato" style="--gap: 8px; --basis: 240px">
                                <span class="label">Estrato</span>
                                <div class="choices" style="gap: 6px; flex-wrap: nowrap">
                                    @for (var stratum = 1; stratum <= 6; stratum++)
                                    {
                                        var value = stratum;
                                        <button type="button" class="choice" style="font-size: 15px" aria-pressed="@(details.Stratum == value ? "true" : "false")" @onclick="() => details.Stratum = value">@value</button>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="grid-auto" style="--min: 170px; --gap: 14px">
                            <div class="field">
                                <label class="label" for="area">Área (m²)</label>
                                <input id="area" type="number" class="input" min="20" step="0.1" @bind="details.Area" />
                            </div>
                            <div class="field">
                                <label class="label" for="bedrooms">Habitaciones</label>
                                <input id="bedrooms" type="number" class="input" min="0" @bind="details.Bedrooms" />
                            </div>
                            <div class="field">
                                <label class="label" for="bathrooms">Baños</label>
                                <input id="bathrooms" type="number" class="input" min="1" @bind="details.Bathrooms" />
                            </div>
                            <div class="field">
                                <label class="label" for="parking">Parqueaderos</label>
                                <input id="parking" type="number" class="input" min="0" @bind="details.ParkingSpots" />
                            </div>
                            <div class="field">
                                <label class="label" for="floor">Piso</label>
                                <input id="floor" type="number" class="input" min="1" @bind="details.Floor" />
                            </div>
                            <div class="field">
                                <label class="label" for="fee">Administración (COP)</label>
                                <input id="fee" type="number" class="input" min="0" step="1000" @bind="details.AdministrationFee" />
                            </div>
                            <div class="field">
                                <label class="label" for="city">Ciudad</label>
                                <input id="city" class="input" @bind="details.City" />
                            </div>
                            <div class="field">
                                <label class="label" for="neighborhood">Barrio</label>
                                <input id="neighborhood" class="input" @bind="details.Neighborhood" />
                            </div>
                            <div class="field">
                                <label class="label" for="address">Dirección</label>
                                <input id="address" class="input" @bind="details.Address" />
                            </div>
                        </div>

                        <label class="check">
                            <input type="checkbox" @bind="details.HasElevator" />
                            Tiene ascensor
                        </label>

                        <div class="field">
                            <div class="row row-between">
                                <label class="label" for="description">Descripción</label>
                                <span class="counter @(DescriptionLength >= ListingLimits.MinDescriptionLength ? "" : "text-danger")">
                                    @DescriptionLength / @ListingLimits.MaxDescriptionLength · mínimo @ListingLimits.MinDescriptionLength
                                </span>
                            </div>
                            <textarea id="description" class="textarea" rows="5" maxlength="@ListingLimits.MaxDescriptionLength" @bind="details.Description" @bind:event="oninput"></textarea>
                        </div>
                    </fieldset>

                    <ErrorAlert Exception="detailsError" />

                    @if (CanEdit)
                    {
                        <div class="row row-end">
                            <button type="button" class="btn btn-lg btn-primary" disabled="@busy" @onclick="SaveDetailsAsync">Guardar datos</button>
                        </div>
                    }
                </section>
            </div>

            <aside class="stack" style="flex: 2 1 280px; --gap: 20px">
                @if (listing.Status == "Draft")
                {
                    <section class="card card-tight card-dark" aria-label="Para enviar a revisión" style="--gap: 10px">
                        <h2 class="h2 h2-xs">Para enviar a revisión</h2>
                        @foreach (var item in Checklist)
                        {
                            <div class="row" style="flex-wrap: nowrap">
                                <span class="check-mark @(item.Ok ? "ok" : "")" aria-hidden="true">@(item.Ok ? "✓" : "·")</span>
                                <span class="grow" style="--basis: 0">@item.Label</span>
                                <span class="smaller muted">@item.State</span>
                            </div>
                        }
                    </section>
                }

                <section class="card card-tight" aria-label="Precio" style="--gap: 12px">
                    <h2 class="smaller strong muted">Precio de @RentalsFormat.Term(listing.Operation).ToLowerInvariant()</h2>
                    <div class="price-lg">@(listing.Price is null ? "Sin precio" : RentalsFormat.Money(listing.Price))</div>
                    @if (CanChangePrice)
                    {
                        <label class="label" for="new-price">Nuevo precio (COP)</label>
                        <div class="row" style="--gap: 8px">
                            <input id="new-price" type="number" class="input grow" style="--basis: 140px" min="0" step="10000" @bind="priceDraft" />
                            <button type="button" class="btn" disabled="@(busy || priceDraft <= 0 || priceDraft == listing.Price)" @onclick="ChangePriceAsync">Cambiar</button>
                        </div>
                        <ErrorAlert Exception="priceError" />
                    }
                    <span class="smaller muted">Mínimo $300.000 en arriendo y $30.000.000 en venta. Una vez publicada, solo cambia una vez cada 24 horas.</span>
                </section>

                @if (listing.Status is "Published" or "Paused")
                {
                    <section class="card card-tight card-lime" aria-label="Cerrar negocio" style="--gap: 12px">
                        <h2 class="h2 h2-xs">Cerrar negocio</h2>
                        <div class="field">
                            <label class="label" for="final-price">Valor final (COP)</label>
                            <input id="final-price" type="number" class="input" min="0" step="10000" @bind="closeFinalPrice" />
                        </div>
                        <div class="field">
                            <label class="label" for="signed-on">Fecha de firma · no puede ser futura</label>
                            <input id="signed-on" type="date" class="input" @bind="closeSignedOn" />
                        </div>
                        <ErrorAlert Exception="closeError" />
                        <button type="button" class="btn btn-primary" disabled="@(busy || closeFinalPrice <= 0)" @onclick="CloseAsync">Cerrar negocio</button>
                    </section>
                }

                <section class="card card-tight" aria-label="Vigencia y participantes" style="--gap: 10px">
                    <h2 class="h2 h2-xs">Vigencia y participantes</h2>
                    <div class="kv"><span class="muted">Propietario</span><span>@listing.OwnerName</span></div>
                    <div class="kv"><span class="muted">Creada por</span><span>@CreatedBy</span></div>
                    <div class="kv"><span class="muted">Creada</span><span>@RentalsFormat.Moment(listing.CreatedAt)</span></div>
                    <div class="kv"><span class="muted">Vence</span><span>@RentalsFormat.Moment(listing.ExpiresAt)</span></div>
                    @if (listing.FinalPrice is not null)
                    {
                        <div class="kv"><span class="muted">Valor final</span><span>@RentalsFormat.Money(listing.FinalPrice)</span></div>
                        <div class="kv"><span class="muted">Firmada el</span><span>@RentalsFormat.Date(listing.SignedOn)</span></div>
                    }
                    <a class="link" href="rentals/owners">Ver propietario</a>
                </section>

                <section class="card card-tight" aria-label="Visitas" style="--gap: 10px">
                    <h2 class="h2 h2-xs">Visitas</h2>
                    @if (visits.Count == 0)
                    {
                        <span class="small muted">Nadie pidió visitar este inmueble todavía.</span>
                    }
                    @foreach (var visit in visits)
                    {
                        <a class="line-row small" href="rentals/visits/@visit.Id" style="justify-content: space-between; min-height: 44px">
                            <span class="stack" style="--gap: 0">
                                <span class="strong">@visit.VisitorName</span>
                                <span class="muted">@VisitSummary(visit)</span>
                            </span>
                            <RentalStatusPill Status="@visit.Status" />
                        </a>
                    }
                    <button type="button" class="btn" disabled="@(listing.Status != "Published")" @onclick="() => Open(Panel.Visit)">Solicitar visita como interesado</button>
                </section>
            </aside>
        </div>
    }
</div>

@code {
    private static readonly string[] RailSteps = ["Borrador", "En revisión", "Publicada", "Cerrada"];

    [Parameter] public Guid Id { get; set; }

    private ListingDto? listing;
    private IReadOnlyList<VisitDto> visits = [];
    private DetailsForm details = new();
    private Panel panel;
    private bool busy;
    private long priceDraft;
    private long closeFinalPrice;
    private DateOnly closeSignedOn = DateOnly.FromDateTime(RentalsFormat.Today);

    private ApiException? loadError;
    private ApiException? actionError;
    private ApiException? panelError;
    private ApiException? detailsError;
    private ApiException? priceError;
    private ApiException? closeError;

    private enum Panel
    {
        None,
        Withdraw,
        Visit
    }

    private bool CanEdit => listing?.Status is "Draft" or "InReview" or "Published" or "Paused";

    private bool CanChangePrice => CanEdit || listing?.Status == "Expired";

    private bool CanWithdraw => listing?.Status is not ("Closed" or "Withdrawn");

    private bool Ready => Checklist.All(item => item.Ok);

    private int DescriptionLength => details.Description.Trim().Length;

    private int RailIndex => listing!.Status switch
    {
        "Draft" => 0,
        "InReview" => 1,
        "Closed" => 3,
        "Withdrawn" => -1,
        _ => 2
    };

    private (string Label, bool Ok, string State)[] Checklist =>
    [
        ("Datos del inmueble", listing!.City is not null, listing.City is not null ? "Completos" : "Pendientes"),
        ("Precio", listing.Price is not null, listing.Price is not null ? RentalsFormat.Money(listing.Price) : "Pendiente"),
        ("Fotos", listing.Photos.Count >= ListingLimits.MinPhotos, $"{listing.Photos.Count} de {ListingLimits.MinPhotos}")
    ];

    private string CreatedBy =>
        Actor.Is(listing!.CreatedBy) ? "Tú"
        : listing.CreatedBy == listing.OwnerId ? listing.OwnerName
        : RentalsFormat.Short(listing.CreatedBy);

    private (string Variant, string Title, string Text)? Note => listing!.Status switch
    {
        "Draft" when listing.RejectionReasons.Count > 0 =>
            ("warning", $"Moderación la devolvió: {string.Join(", ", listing.RejectionReasons.Select(RentalsFormat.Term)).ToLowerInvariant()}", "Corrige lo necesario y vuelve a enviarla a revisión."),
        "InReview" => ("info", "Esperando a moderación", "Puedes seguir editando; un moderador la aprueba o la rechaza con motivos."),
        "Paused" => ("warning", "Pausada por el propietario", "No aparece en el catálogo ni recibe visitas hasta que la reanudes."),
        "Expired" => ("warning", $"La vigencia terminó el {RentalsFormat.Moment(listing.ExpiresAt)}", "Renuévala para que vuelva a estar visible."),
        "Suspended" => ("danger", "Suspendida por moderación", $"Motivo: {listing.StatusReason}. Solo moderación puede levantar la suspensión."),
        "Closed" => ("ink", "Negocio cerrado", "Valor final y fecha de firma registrados. La publicación ya no se puede editar."),
        "Withdrawn" => ("danger", "Retirada", $"Motivo: {listing.StatusReason}. La publicación no admite más cambios."),
        _ => null
    };

    protected override Task OnParametersSetAsync() => LoadAsync();

    private static string VisitSummary(VisitDto visit) =>
        visit.ScheduledStartsAt is { } start ? $"{RentalsFormat.Day(start)} · {RentalsFormat.Range(start)}"
        : visit.IsNegotiating ? $"Propone {visit.ProposedSlots.Count} franjas · responde antes del {RentalsFormat.Moment(visit.RespondBy)}"
        : "Sin franja agendada";

    private async Task LoadAsync(bool keepForm = false)
    {
        try
        {
            var listingTask = Api.GetByIdAsync(Id, CancellationToken.None);
            var visitsTask = VisitsApi.ListAsync(Id, null, null, 1, 50, CancellationToken.None);
            await Task.WhenAll(listingTask, visitsTask);

            listing = listingTask.Result;
            visits = visitsTask.Result.Items;

            if (!keepForm)
            {
                details = DetailsForm.From(listing);
                priceDraft = listing.Price ?? 0;
                closeFinalPrice = listing.Price ?? 0;
            }

            loadError = null;
        }
        catch (ApiException ex)
        {
            loadError = ex;
        }
    }

    private void Open(Panel target)
    {
        panel = target;
        panelError = null;
    }

    private Task RunAsync(Func<Task> action) => ExecuteAsync(action, ex => actionError = ex);

    private Task SaveDetailsAsync() =>
        ExecuteAsync(() => Api.UpdateDetailsAsync(Id, details.ToRequest(), CancellationToken.None), ex => detailsError = ex);

    private Task ChangePriceAsync() =>
        ExecuteAsync(() => Api.ChangePriceAsync(Id, new ChangeListingPriceRequest(priceDraft), CancellationToken.None), ex => priceError = ex);

    private Task CloseAsync() =>
        ExecuteAsync(() => Api.CloseAsync(Id, new CloseListingRequest(closeFinalPrice, closeSignedOn), CancellationToken.None), ex => closeError = ex);

    private Task WithdrawAsync(string reason) =>
        ExecuteAsync(async () =>
        {
            await Api.WithdrawAsync(Id, reason, CancellationToken.None);
            panel = Panel.None;
        }, ex => panelError = ex);

    private Task RequestVisitAsync(IReadOnlyList<DateTimeOffset> slots) =>
        ExecuteAsync(async () =>
        {
            var visitId = await VisitsApi.RequestAsync(new RequestVisitRequest(Id, slots), CancellationToken.None);
            Nav.NavigateTo($"/rentals/visits/{visitId}");
        }, ex => panelError = ex);

    private async Task ExecuteAsync(Func<Task> action, Action<ApiException?> report)
    {
        busy = true;
        try
        {
            await action();
            report(null);
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            report(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private sealed class DetailsForm
    {
        public PropertyType Type { get; set; }
        public decimal Area { get; set; } = 60;
        public int Bedrooms { get; set; } = 2;
        public int Bathrooms { get; set; } = 1;
        public int ParkingSpots { get; set; }
        public int Stratum { get; set; } = 3;
        public int? Floor { get; set; }
        public bool HasElevator { get; set; }
        public long AdministrationFee { get; set; }
        public string City { get; set; } = "";
        public string Neighborhood { get; set; } = "";
        public string Address { get; set; } = "";
        public string Description { get; set; } = "";

        public static DetailsForm From(ListingDto listing) => listing.City is null
            ? new DetailsForm()
            : new DetailsForm
            {
                Type = Enum.Parse<PropertyType>(listing.Type!),
                Area = listing.Area ?? 0,
                Bedrooms = listing.Bedrooms ?? 0,
                Bathrooms = listing.Bathrooms ?? 1,
                ParkingSpots = listing.ParkingSpots ?? 0,
                Stratum = listing.Stratum ?? 1,
                Floor = listing.Floor,
                HasElevator = listing.HasElevator,
                AdministrationFee = listing.AdministrationFee ?? 0,
                City = listing.City,
                Neighborhood = listing.Neighborhood ?? "",
                Address = listing.Address ?? "",
                Description = listing.Description ?? ""
            };

        public UpdateListingDetailsRequest ToRequest() =>
            new(Type, Area, Bedrooms, Bathrooms, ParkingSpots, Stratum, Floor, HasElevator, AdministrationFee,
                City, Neighborhood, Address, Description);
    }
}
