@page "/rentals/listings"
@inject ListingsApiClient Api
@inject OwnersApiClient OwnersApi
@inject RentalsActor Actor
@inject NavigationManager Nav

<PageTitle>Publicaciones · NotificationLog</PageTitle>

<div class="page-header">
    <div>
        <h1>Publicaciones</h1>
        <p>Inmuebles en venta o arriendo, desde el borrador hasta el cierre.</p>
    </div>
    <button class="btn btn-primary" @onclick="OpenCreateAsync">+ Nueva publicación</button>
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

<div class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Buscar</label>
            <input class="form-control" placeholder="Ciudad, barrio o dirección… (Enter para buscar)"
                   @bind="search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>
        <div class="col-md-2">
            <label class="form-label">Estado</label>
            <select class="form-select" @bind="statusFilter" @bind:after="RefreshAsync">
                <option value="">Todos</option>
                @foreach (var s in RentalsFormat.Values<ListingStatus>())
                {
                    <option value="@s">@RentalsFormat.Status(s.ToString())</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">Operación</label>
            <select class="form-select" @bind="operationFilter" @bind:after="RefreshAsync">
                <option value="">Todas</option>
                @foreach (var o in RentalsFormat.Values<Operation>())
                {
                    <option value="@o">@RentalsFormat.Term(o)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="only-mine" @bind="onlyMine" @bind:after="RefreshAsync" />
                <label class="form-check-label small" for="only-mine">Solo donde participo</label>
            </div>
        </div>
        <div class="col-md-2 text-md-end">
            <button class="btn btn-outline-secondary w-100 w-md-auto" @onclick="RefreshAsync">Filtrar</button>
        </div>
    </div>
</div>

<div class="table-card">
    @if (loading)
    {
        <div class="p-4 text-center text-muted">Cargando…</div>
    }
    else if (page is { Items.Count: 0 })
    {
        <EmptyState Text="No se encontraron publicaciones." Icon="🏠" />
    }
    else if (page is not null)
    {
        <div class="table-responsive-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Inmueble</th>
                        <th>Operación</th>
                        <th>Precio</th>
                        <th>Habitaciones · área</th>
                        <th>Estado</th>
                        <th>Actualizada</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in page.Items)
                    {
                        <tr class="row-link" @onclick='() => Nav.NavigateTo($"/rentals/listings/{l.Id}")'>
                            <td>
                                <div>@RentalsFormat.ListingTitle(l.Type, l.Neighborhood, l.City)</div>
                                <ShortId Value="l.Id" />
                            </td>
                            <td>@RentalsFormat.Term(l.Operation)</td>
                            <td>@RentalsFormat.Money(l.Price)</td>
                            <td>@(l.Bedrooms is null ? "—" : $"{l.Bedrooms} hab · {l.Area:0.#} m²")</td>
                            <td>
                                <RentalStatusPill Status="@l.Status" />
                            </td>
                            <td class="text-muted small">@RentalsFormat.Date(l.UpdatedAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-3 pb-3">
            <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPageChange="GoToPage" />
        </div>
    }
</div>

<Modal Title="Nueva publicación" @bind-IsVisible="showCreate">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">Operación</label>
            <select class="form-select" @bind="createOperation">
                @foreach (var o in RentalsFormat.Values<Operation>())
                {
                    <option value="@o">@RentalsFormat.Term(o)</option>
                }
            </select>
        </div>
        @if (Actor.IsStaff)
        {
            <div class="mb-3">
                <label class="form-label">Propietario</label>
                <select class="form-select" @bind="createOwnerId">
                    <option value="">Seleccioná un propietario…</option>
                    @foreach (var o in owners)
                    {
                        <option value="@o.Id">@OwnerName(o)</option>
                    }
                </select>
                <div class="form-hint">La publicación queda a nombre del propietario; vos quedás como quien la creó.</div>
            </div>
        }
        else
        {
            <div class="form-hint">La publicación queda a tu nombre como propietario.</div>
        }
        @if (createError is not null)
        {
            <div class="mt-3">
                <ErrorAlert Exception="createError" />
            </div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showCreate = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(creating || createOwnerId == Guid.Empty)" @onclick="CreateAsync">Crear borrador</button>
    </FooterContent>
</Modal>

@code {
    private PagedResult<ListingSummaryDto>? page;
    private bool loading = true;
    private ApiException? error;

    private string search = "";
    private string statusFilter = "";
    private string operationFilter = "";
    private bool onlyMine;
    private int currentPage = 1;

    private bool showCreate;
    private bool creating;
    private ApiException? createError;
    private Operation createOperation = Operation.Rent;
    private Guid createOwnerId = Guid.Empty;
    private IReadOnlyList<OwnerDto> owners = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            page = await Api.ListAsync(
                string.IsNullOrWhiteSpace(search) ? null : search,
                Enum.TryParse<ListingStatus>(statusFilter, out var status) ? status : null,
                Enum.TryParse<Operation>(operationFilter, out var operation) ? operation : null,
                onlyMine ? Actor.Id ?? Guid.Empty : null,
                currentPage,
                10,
                CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoToPage(int p)
    {
        currentPage = p;
        return LoadAsync();
    }

    private Task OnSearchKeyUp(KeyboardEventArgs e) => e.Key == "Enter" ? RefreshAsync() : Task.CompletedTask;

    private async Task OpenCreateAsync()
    {
        createError = null;
        createOwnerId = Actor.IsStaff ? Guid.Empty : Actor.Id ?? Guid.Empty;
        showCreate = true;

        if (!Actor.IsStaff)
            return;

        try
        {
            owners = (await OwnersApi.ListAsync(1, 100, CancellationToken.None)).Items;
        }
        catch (ApiException ex)
        {
            createError = ex;
        }
    }

    private async Task CreateAsync()
    {
        creating = true;
        try
        {
            var id = await Api.DraftAsync(new DraftListingRequest(createOwnerId, createOperation), CancellationToken.None);
            showCreate = false;
            Nav.NavigateTo($"/rentals/listings/{id}");
        }
        catch (ApiException ex)
        {
            createError = ex;
        }
        finally
        {
            creating = false;
        }
    }

    private static string OwnerName(OwnerDto owner) =>
        owner.LegalName ?? $"{owner.FirstNames} {owner.LastNames}";
}
