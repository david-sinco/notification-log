@page "/rentals/visits/{Id:guid}"
@inject VisitsApiClient Api
@inject RentalsActor Actor

<PageTitle>Visita · Llave</PageTitle>

<a href="/rentals/visits" class="back-link">← Volver a visitas</a>

@if (loading && visit is null)
{
    <div class="p-5 text-center text-muted">Cargando…</div>
}
else if (loadError is not null)
{
    <ErrorAlert Exception="loadError" />
}
else if (visit is not null)
{
    <div class="page-header">
        <div>
            <p class="eyebrow">Visita</p>
            <h1>Visita @(visit.ScheduledStartsAt is { } scheduled ? $"el {RentalsFormat.Date(scheduled)}" : "por acordar")</h1>
            <p>Franjas de una hora, hora de Colombia · <ShortId Value="visit.Id" /></p>
        </div>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <RentalStatusPill Status="@visit.Status" />
            @if (IsMyTurn)
            {
                <button class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="OpenSlots">Proponer otras franjas</button>
            }
            @if (visit.Status == "Scheduled" && IsHost)
            {
                <button class="btn btn-primary btn-sm" disabled="@(busy || !HasStarted)" @onclick="() => RunAsync(() => Api.MarkCompletedAsync(Id, CancellationToken.None))">Se realizó</button>
                <button class="btn btn-outline-secondary btn-sm" disabled="@(busy || !HasStarted)" @onclick="() => RunAsync(() => Api.MarkNoShowAsync(Id, CancellationToken.None))">No asistió</button>
            }
            @if (CanCancel)
            {
                <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="OpenCancel">Cancelar</button>
            }
        </div>
    </div>

    @if (actionError is not null)
    {
        <ErrorAlert Exception="actionError" />
    }

    @if (visit.IsNegotiating)
    {
        <div class="alert alert-info-soft small">
            Le toca responder al @(visit.Status == "AwaitingHost" ? "anfitrión" : "visitante") antes del @RentalsFormat.Date(visit.RespondBy):
            acepta una de las franjas, propone otras o cancela. Si no responde, la visita vence.
        </div>
    }
    else if (visit.Status == "Scheduled")
    {
        <div class="alert alert-info-soft small">
            El anfitrión registra el resultado cuando empieza la visita; si no lo hace, se da por realizada 72 horas después de que termine.
            Cancelar con menos de 12 horas cuenta como cancelación tardía.
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="surface-card">
                <h2 class="h6">Datos</h2>
                <dl class="kv-list mb-0">
                    <dt>Publicación</dt>
                    <dd><ShortId Value="visit.ListingId" Href="@($"/rentals/listings/{visit.ListingId}")" /></dd>
                    <dt>Visitante</dt>
                    <dd><ShortId Value="visit.VisitorId" /></dd>
                    <dt>Anfitrión</dt>
                    <dd><ShortId Value="visit.HostId" /></dd>
                    <dt>Solicitada</dt>
                    <dd>@RentalsFormat.Date(visit.RequestedAt)</dd>
                    @if (visit.CancelledBy is not null)
                    {
                        <dt>Cancelada por</dt>
                        <dd>@RentalsFormat.Term(visit.CancelledBy)@(visit.IsLateCancellation ? " · tardía" : "")</dd>
                    }
                    @if (visit.CancellationReason is not null)
                    {
                        <dt>Motivo</dt>
                        <dd>@visit.CancellationReason</dd>
                    }
                    @if (visit.ClosedBy is not null)
                    {
                        <dt>Cerrada por</dt>
                        <dd>@RentalsFormat.Term(visit.ClosedBy)</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="surface-card">
                @if (visit.ScheduledStartsAt is { } start)
                {
                    <h2 class="h6">Franja agendada</h2>
                    <ul class="slot-list">
                        <li><span>@Range(start)</span></li>
                    </ul>
                }
                else if (visit.ProposedSlots.Count > 0)
                {
                    <h2 class="h6">Franjas propuestas</h2>
                    <ul class="slot-list">
                        @foreach (var slot in visit.ProposedSlots)
                        {
                            <li>
                                <span>@Range(slot)</span>
                                @if (IsMyTurn)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@busy"
                                            @onclick="() => RunAsync(() => Api.ScheduleAsync(Id, slot, CancellationToken.None))">
                                        Aceptar esta
                                    </button>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <h2 class="h6">Franjas</h2>
                    <p class="text-muted small mb-0">La visita terminó sin una franja agendada.</p>
                }
            </div>
        </div>
    </div>
}

<ReasonModal Title="Cancelar visita" ConfirmText="Cancelar visita"
             Danger="true" Busy="modalBusy" Error="modalError"
             @bind-IsVisible="showCancel" OnConfirm="CancelAsync" />

<Modal Title="Proponer otras franjas" @bind-IsVisible="showSlots">
    <ChildContent>
        <p class="text-muted small">
            Proponé hasta @VisitLimits.MaxSlots franjas de una hora, en hora de Colombia, entre las @VisitLimits.EarliestHour:00
            y las @VisitLimits.LatestHour:00 (la última empieza a las @(VisitLimits.LatestHour - 1):00), con al menos @VisitLimits.MinLeadHours horas de antelación y hasta
            @VisitLimits.MaxLeadDays días. Reemplazan a las propuestas actuales.
        </p>
        @for (var i = 0; i < slotDrafts.Length; i++)
        {
            var index = i;
            <div class="mb-2">
                <label class="form-label">Franja @(index + 1)@(index == 0 ? "" : " (opcional)")</label>
                <input type="datetime-local" class="form-control" @bind="slotDrafts[index]" />
            </div>
        }
        @if (modalError is not null)
        {
            <div class="mt-3"><ErrorAlert Exception="modalError" /></div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showSlots = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(modalBusy || slotDrafts.All(s => s is null))" @onclick="CounterProposeAsync">Proponer</button>
    </FooterContent>
</Modal>

@code {
    [Parameter] public Guid Id { get; set; }

    private VisitDto? visit;
    private bool loading = true;
    private ApiException? loadError;
    private ApiException? actionError;
    private bool busy;

    private bool modalBusy;
    private ApiException? modalError;
    private bool showCancel;
    private bool showSlots;
    private DateTime?[] slotDrafts = new DateTime?[VisitLimits.MaxSlots];

    private bool IsHost => visit is not null && Actor.Is(visit.HostId);

    private bool IsVisitor => visit is not null && Actor.Is(visit.VisitorId);

    private bool IsMyTurn => visit?.Status switch
    {
        "AwaitingHost" => IsHost,
        "AwaitingVisitor" => IsVisitor,
        _ => false
    };

    private bool HasStarted => visit?.ScheduledStartsAt is { } start && start <= DateTimeOffset.UtcNow;

    private bool CanCancel =>
        visit is not null
        && (IsHost || IsVisitor)
        && (visit.IsNegotiating || (visit.Status == "Scheduled" && !HasStarted));

    protected override Task OnParametersSetAsync() => LoadAsync();

    private static string Range(DateTimeOffset start) =>
        $"{RentalsFormat.Date(start)} – {start.AddHours(1).ToOffset(RentalsFormat.ColombiaOffset):HH:mm}";

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            visit = await Api.GetByIdAsync(Id, CancellationToken.None);
            loadError = null;
        }
        catch (ApiException ex)
        {
            loadError = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try
        {
            await action();
            actionError = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            actionError = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RunModalAsync(Func<Task> action, Action close)
    {
        modalBusy = true;
        try
        {
            await action();
            close();
            modalError = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            modalError = ex;
        }
        finally
        {
            modalBusy = false;
        }
    }

    private void OpenCancel()
    {
        modalError = null;
        showCancel = true;
    }

    private void OpenSlots()
    {
        var day = DateTimeOffset.UtcNow.ToOffset(RentalsFormat.ColombiaOffset).Date.AddDays(2);
        slotDrafts = [day.AddHours(10), day.AddHours(15), null];
        modalError = null;
        showSlots = true;
    }

    private Task CancelAsync(string reason) =>
        RunModalAsync(() => Api.CancelAsync(Id, reason, CancellationToken.None), () => showCancel = false);

    private Task CounterProposeAsync()
    {
        var slots = slotDrafts.OfType<DateTime>().Select(RentalsFormat.FromColombia).ToList();

        return RunModalAsync(() => Api.CounterProposeAsync(Id, slots, CancellationToken.None), () => showSlots = false);
    }
}
