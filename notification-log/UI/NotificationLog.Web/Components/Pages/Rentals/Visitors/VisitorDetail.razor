@page "/rentals/visitors/{Id:guid}"
@attribute [Authorize(Roles = $"{IdentityRoles.Administrador},{IdentityRoles.Moderador}")]
@inject VisitorsApiClient Api

<PageTitle>@(detail?.Visitor.Name ?? "Visitante") · Llave</PageTitle>

<div class="page">
    <a class="link btn-start" href="rentals/visitors" style="gap: 6px">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        Visitantes
    </a>

    <ErrorAlert Exception="error" />

    @if (detail is { Visitor: var visitor })
    {
        <section class="card card-dark" style="--gap: 18px">
            <div class="row" style="--gap: 16px">
                <span class="avatar avatar-lime" style="width: 72px; height: 72px; font-size: 22px" aria-hidden="true">@RentalsFormat.Initials(visitor.Name)</span>
                <div class="stack grow" style="--gap: 4px; --basis: 240px">
                    <p class="eyebrow muted">Visitante · ID @RentalsFormat.Short(visitor.Id)</p>
                    <h1 class="title title-detail">@visitor.Name</h1>
                </div>
            </div>
            <div class="grid-auto" style="--min: 200px">
                <div class="fact fact-box">
                    <span class="fact-label muted">Correo</span>
                    <span class="fact-value"><ContactLine Value="@visitor.Email" Missing="Sin correo confirmado" Label="correo" /></span>
                </div>
                <div class="fact fact-box">
                    <span class="fact-label muted">Teléfono</span>
                    <span class="fact-value"><ContactLine Value="@visitor.Phone" Missing="Sin teléfono confirmado" Label="teléfono" /></span>
                </div>
                <div class="fact fact-box">
                    <span class="fact-label muted">Visitante desde</span>
                    <span class="fact-value">@RentalsFormat.Date(visitor.RegisteredAt)</span>
                </div>
            </div>
        </section>

        <div class="split">
            <section class="card split-detail" aria-label="Visitas" style="--gap: 10px">
                <h2 class="h2">Visitas</h2>
                @if (detail.Visits.Count == 0)
                {
                    <p class="muted">Todavía no ha pedido visitas.</p>
                }
                <div class="stack" style="--gap: 0">
                    @foreach (var visit in detail.Visits)
                    {
                        <a class="line-row" href="rentals/visits/@visit.VisitId">
                            <span class="stack grow" style="--gap: 0; --basis: 220px">
                                <span class="strong">@RentalsFormat.ListingTitle(visit.ListingType, visit.ListingNeighborhood, visit.ListingCity)</span>
                                <span class="id">@RentalsFormat.Moment(visit.FirstSlot) · anfitrión @visit.HostName</span>
                            </span>
                            <RentalStatusPill Status="@visit.Status" />
                        </a>
                    }
                </div>
            </section>

            <section class="card split-list" aria-label="Actividad" style="--gap: 12px; flex: 2 1 300px">
                <h2 class="h2">Actividad</h2>
                <ol class="stack" style="--gap: 14px">
                    @foreach (var entry in detail.Activity)
                    {
                        <li class="row row-top" style="flex-wrap: nowrap; --gap: 12px">
                            <span class="dot @Dot(entry)" style="margin-top: 6px" aria-hidden="true"></span>
                            <span class="stack" style="--gap: 0">
                                <span class="small">@Describe(entry)</span>
                                <span class="id">@RentalsFormat.Moment(entry.At)</span>
                            </span>
                        </li>
                    }
                </ol>
            </section>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private VisitorDetailDto? detail;
    private ApiException? error;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            detail = await Api.GetByIdAsync(Id, CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
    }

    private static string Describe(VisitorActivityDto entry)
    {
        var place = entry.ListingNeighborhood ?? "una publicación";
        var host = entry.By == "Host";
        var who = host ? $"{entry.HostName} " : "";

        return entry.Action switch
        {
            "Registered" => "Se registró como visitante",
            "NameChanged" => "Cambió su nombre en la cuenta",
            "EmailChanged" => "Confirmó un correo nuevo en su cuenta",
            "PhoneChanged" => "Confirmó un teléfono nuevo en su cuenta",
            "Requested" => $"Pidió una visita en {place}",
            "CounterProposed" => $"{who}{(host ? "propuso" : "Propuso")} otras franjas en {place}",
            "Scheduled" => $"{who}{(host ? "aceptó" : "Aceptó")} la franja del {RentalsFormat.Moment(entry.Slot)} en {place}",
            "Cancelled" => $"{who}{(host ? "canceló" : "Canceló")} la visita en {place}{(entry.IsLate ? " (tardía)" : "")}",
            "Expired" => $"Venció la visita en {place}",
            "Completed" => $"Realizó la visita en {place}",
            "NoShow" => $"No asistió a la visita en {place}",
            _ => entry.Action
        };
    }

    private static string Dot(VisitorActivityDto entry) => entry switch
    {
        { Action: "Cancelled" or "NoShow" } => "dot-danger",
        { Action: "NameChanged" or "EmailChanged" or "PhoneChanged" or "Registered" } => "dot-neutral",
        { By: "Visitor" } => "dot-info",
        _ => ""
    };
}
