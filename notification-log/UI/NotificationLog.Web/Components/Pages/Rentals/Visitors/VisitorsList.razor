@page "/rentals/visitors"
@attribute [Authorize(Roles = $"{IdentityRoles.Administrador},{IdentityRoles.Moderador}")]
@inject VisitorsApiClient Api

<PageTitle>Visitantes · Llave</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Arriendos</p>
        <h1>Visitantes</h1>
        <p>Las personas registradas en Llave para solicitar visitas a los inmuebles publicados.</p>
    </div>
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

@if (loading)
{
    <div class="p-4 text-center text-muted">Cargando…</div>
}
else if (page is { Items.Count: 0 })
{
    <div class="table-card">
        <EmptyState Text="No se encontraron visitantes." Icon="🧳" />
    </div>
}
else if (page is not null)
{
    <div class="table-card">
        <div class="table-responsive-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Estado</th>
                        <th>Documento</th>
                        <th>Correo</th>
                        <th>Teléfono</th>
                        <th>Registrado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var visitor in page.Items)
                    {
                        <tr>
                            <td>
                                <div>@visitor.DisplayName</div>
                                <ShortId Value="visitor.Id" />
                            </td>
                            <td><RentalStatusPill Status="@visitor.Status" /></td>
                            <td>@Identification(visitor)</td>
                            <td>@visitor.Email</td>
                            <td>@visitor.Phone</td>
                            <td class="text-muted small">@RentalsFormat.Date(visitor.RegisteredAt)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-3 pb-3">
            <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPageChange="GoToPage" />
        </div>
    </div>
}

@code {
    private const int PageSize = 20;

    private PagedResult<VisitorDto>? page;
    private bool loading = true;
    private ApiException? error;
    private int currentPage = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            page = await Api.ListAsync(currentPage, PageSize, CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private Task GoToPage(int p)
    {
        currentPage = p;

        return LoadAsync();
    }

    private static string Identification(VisitorDto visitor)
        => visitor.DocumentNumber is null ? "—" : $"{OwnerLabels.Document(visitor.DocumentType)} {visitor.DocumentNumber}";
}
