@page "/rentals/owners"
@attribute [Authorize(Roles = $"{IdentityRoles.Administrador},{IdentityRoles.Moderador},{IdentityRoles.Propietario}")]
@using System.Net
@inject OwnersApiClient Api
@inject RentalsActor Actor
@inject NavigationManager Nav

<PageTitle>Propietarios · Llave</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Arriendos</p>
        <h1>Propietarios</h1>
        <p>@Subtitle</p>
    </div>
    @if (CanRegister)
    {
        <button class="btn btn-primary" @onclick="OpenCreate">+ Registrar propietario</button>
    }
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

@if (Actor.IsStaff)
{
    <div class="filter-bar">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="only-mine" checked="@onlyMine" @onchange="ToggleOnlyMine" />
            <label class="form-check-label" for="only-mine">Solo los que registré yo</label>
        </div>
    </div>
}

@if (loading)
{
    <div class="p-4 text-center text-muted">Cargando…</div>
}
else if (!Actor.IsStaff)
{
    @if (ownRecord is null)
    {
        <div class="surface-card">
            <EmptyState Text="Aún no estás registrado como propietario." Icon="🔑" />
            <p class="form-hint text-center mb-0">
                Registra tus datos para poder publicar inmuebles y atender visitas.
            </p>
        </div>
    }
    else
    {
        <div class="table-card">
            <OwnerRows Owners="[ownRecord]" OnSelect="Open" />
        </div>
    }
}
else if (page is { Items.Count: 0 })
{
    <div class="table-card">
        <EmptyState Text="No se encontraron propietarios." Icon="🔑" />
    </div>
}
else if (page is not null)
{
    <div class="table-card">
        <OwnerRows Owners="page.Items" OnSelect="Open" />
        <div class="px-3 pb-3">
            <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPageChange="GoToPage" />
        </div>
    </div>
}

<Modal Title="Registrar propietario" @bind-IsVisible="showCreate">
    <ChildContent>
        @if (!Actor.IsStaff)
        {
            <div class="alert-info-soft p-3 mb-3 small">
                Te registras a ti mismo como propietario: el registro queda con tu mismo identificador y solo
                puedes hacerlo una vez.
            </div>
        }

        <div class="mb-3">
            <label class="form-label">Tipo de persona</label>
            <select class="form-select" @bind="createCompany">
                <option value="false">Persona natural</option>
                <option value="true">Persona jurídica</option>
            </select>
        </div>

        @if (createCompany)
        {
            <div class="mb-3">
                <label class="form-label">Razón social</label>
                <input class="form-control" maxlength="200" @bind="legalName" />
            </div>
            <div class="mb-3">
                <label class="form-label">NIT</label>
                <input class="form-control" placeholder="900123456-7" @bind="nit" />
                <div class="form-hint">De 8 o 9 dígitos y el dígito de verificación después del guion.</div>
            </div>
        }
        else
        {
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Nombres</label>
                    <input class="form-control" maxlength="100" @bind="firstNames" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Apellidos</label>
                    <input class="form-control" maxlength="100" @bind="lastNames" />
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-md-5">
                    <label class="form-label">Tipo de documento</label>
                    <select class="form-select" @bind="documentType">
                        @foreach (var type in Enum.GetValues<DocumentType>())
                        {
                            <option value="@type">@OwnerLabels.Document(type.ToString())</option>
                        }
                    </select>
                </div>
                <div class="col-md-7">
                    <label class="form-label">Número</label>
                    <input class="form-control" @bind="documentNumber" />
                    <div class="form-hint">@DocumentHint</div>
                </div>
            </div>
        }

        <div class="row g-2 mb-3">
            <div class="col-md-7">
                <label class="form-label">Correo</label>
                <input type="email" class="form-control" maxlength="256" @bind="email" />
            </div>
            <div class="col-md-5">
                <label class="form-label">Teléfono</label>
                <input class="form-control" placeholder="3001234567" @bind="phone" />
                <div class="form-hint">Si no pones indicativo se asume +57.</div>
            </div>
        </div>

        <div class="alert-info-soft p-3 mb-3 small">
            Con el correo y el teléfono se crea la cuenta del propietario en Llave, para que pueda
            confirmarlos y recibir las notificaciones de sus publicaciones y visitas.
        </div>

        @if (createError is not null)
        {
            <ErrorAlert Exception="createError" />
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showCreate = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@creating" @onclick="CreateAsync">Registrar</button>
    </FooterContent>
</Modal>

@code {
    private const int PageSize = 20;

    private PagedResult<OwnerDto>? page;
    private OwnerDto? ownRecord;
    private bool loading = true;
    private ApiException? error;
    private int currentPage = 1;
    private bool onlyMine;

    private bool showCreate;
    private bool creating;
    private ApiException? createError;
    private bool createCompany;
    private string firstNames = "";
    private string lastNames = "";
    private DocumentType documentType = DocumentType.CitizenshipCard;
    private string documentNumber = "";
    private string legalName = "";
    private string nit = "";
    private string email = "";
    private string phone = "";

    private string Subtitle => Actor.IsStaff
        ? "Toda persona natural o jurídica dueña de los inmuebles que se publican."
        : "Tu registro como propietario dentro de Llave.";

    private bool CanRegister => !loading && (Actor.IsStaff || ownRecord is null);

    private string DocumentHint => documentType == DocumentType.Passport
        ? "Entre 5 y 20 letras o números."
        : "Entre 6 y 10 dígitos, sin puntos.";

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            if (Actor.IsStaff)
                page = await Api.ListAsync(onlyMine ? Actor.Require() : null, currentPage, PageSize, CancellationToken.None);
            else
                ownRecord = await LoadOwnRecordAsync();

            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task<OwnerDto?> LoadOwnRecordAsync()
    {
        try
        {
            return await Api.GetByIdAsync(Actor.Require(), CancellationToken.None);
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            return null;
        }
    }

    private Task ToggleOnlyMine(ChangeEventArgs args)
    {
        onlyMine = args.Value is true;
        currentPage = 1;

        return LoadAsync();
    }

    private Task GoToPage(int p)
    {
        currentPage = p;

        return LoadAsync();
    }

    private void Open(OwnerDto owner) => Nav.NavigateTo($"/rentals/owners/{owner.Id}");

    private void OpenCreate()
    {
        createError = null;
        showCreate = true;
    }

    private async Task CreateAsync()
    {
        creating = true;
        try
        {
            var id = createCompany
                ? await Api.RegisterCompanyAsync(
                    new RegisterCompanyOwnerRequest(legalName, nit, email, phone),
                    CancellationToken.None)
                : await Api.RegisterNaturalAsync(
                    new RegisterNaturalOwnerRequest(firstNames, lastNames, documentType, documentNumber, email, phone),
                    CancellationToken.None);

            showCreate = false;
            Nav.NavigateTo($"/rentals/owners/{id}");
        }
        catch (ApiException ex)
        {
            createError = ex;
        }
        finally
        {
            creating = false;
        }
    }
}
