@page "/rentals/owners"
@attribute [Authorize(Roles = $"{IdentityRoles.Administrador},{IdentityRoles.Moderador},{IdentityRoles.Propietario}")]
@using System.Net
@inject OwnersApiClient Api
@inject RentalsActor Actor

<PageTitle>Propietarios · Llave</PageTitle>

<div class="page">
    <header class="page-head">
        <p class="eyebrow">Arriendos</p>
        <h1 class="title">Propietarios</h1>
        <p class="muted">Personas naturales o jurídicas a cuyo nombre quedan las publicaciones.</p>
    </header>

    <ErrorAlert Exception="error" />

    <div class="split">
        <section class="stack" aria-label="Lista de propietarios" style="flex: 3 1 420px">
            @if (Actor.IsStaff)
            {
                <div class="row">
                    <label class="sr-only" for="owner-search">Buscar propietario</label>
                    <input id="owner-search" type="search" class="input input-search grow" style="--basis: 220px" placeholder="Nombre, razón social o documento"
                           @bind="search" @bind:after="RefreshAsync" />
                    <div class="segmented" role="group" aria-label="Tipo">
                        @foreach (var (key, label) in TypeFilters)
                        {
                            <button type="button" aria-pressed="@(typeFilter == key ? "true" : "false")" @onclick="() => SetTypeAsync(key)">@label</button>
                        }
                    </div>
                </div>
            }

            @if (loaded && owners.Count == 0)
            {
                <EmptyState Text="@(Actor.IsStaff ? "No se encontraron propietarios." : "Todavía no estás registrado como propietario.")" />
            }

            <div class="stack" style="--gap: 10px">
                @foreach (var owner in owners)
                {
                    var company = owner.Type == "Company";
                    <article class="card card-tight row" style="padding: 16px; flex-direction: row; --gap: 14px">
                        <span class="avatar @(company ? "avatar-ink" : "avatar-lime")" aria-hidden="true">@RentalsFormat.Initials(OwnerLabels.Name(owner))</span>
                        <div class="stack grow" style="--gap: 2px">
                            <span class="row" style="--gap: 8px">
                                <span class="strong">@OwnerLabels.Name(owner)</span>
                                <StatusPill Text="@OwnerLabels.Type(owner.Type)" />
                            </span>
                            <span class="mono smaller muted">@OwnerLabels.Identification(owner)</span>
                            <span class="small muted wrap-any">@owner.Email · @owner.Phone</span>
                        </div>
                        <a class="link" href="rentals/listings">@owner.ListingCount @(owner.ListingCount == 1 ? "publicación" : "publicaciones")</a>
                    </article>
                }
            </div>

            @if (page is { TotalPages: > 1 })
            {
                <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" Shown="page.Items.Count" Noun="propietarios" OnPageChange="GoToPageAsync" />
            }
        </section>

        @if (CanRegister)
        {
            <section class="card" aria-label="Registrar propietario" style="flex: 2 1 320px; --gap: 16px">
                <h2 class="h2">Registrar propietario</h2>
                <div class="choices" role="group" aria-label="Tipo de propietario">
                    <button type="button" class="choice choice-left" aria-pressed="@(company ? "false" : "true")" @onclick="() => company = false">
                        <span>Persona natural</span>
                        <span>Nombres y documento</span>
                    </button>
                    <button type="button" class="choice choice-left" aria-pressed="@(company ? "true" : "false")" @onclick="() => company = true">
                        <span>Persona jurídica</span>
                        <span>Razón social y NIT</span>
                    </button>
                </div>
                <div class="grid-auto" style="--min: 190px; --gap: 14px">
                    @if (company)
                    {
                        <div class="field">
                            <label class="label" for="o-legal">Razón social</label>
                            <input id="o-legal" class="input" @bind="legalName" />
                        </div>
                        <div class="field">
                            <label class="label" for="o-nit">NIT</label>
                            <input id="o-nit" class="input" @bind="nit" />
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label class="label" for="o-doc-type">Tipo de documento</label>
                            <select id="o-doc-type" class="select" @bind="documentType">
                                @foreach (var type in RentalsFormat.Values<DocumentType>())
                                {
                                    <option value="@type">@OwnerLabels.Document(type.ToString())</option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label class="label" for="o-doc">Número de documento</label>
                            <input id="o-doc" class="input" @bind="documentNumber" />
                        </div>
                        <div class="field">
                            <label class="label" for="o-first">Nombres</label>
                            <input id="o-first" class="input" @bind="firstNames" />
                        </div>
                        <div class="field">
                            <label class="label" for="o-last">Apellidos</label>
                            <input id="o-last" class="input" @bind="lastNames" />
                        </div>
                    }
                    <div class="field">
                        <label class="label" for="o-email">Correo</label>
                        <input id="o-email" type="email" class="input" @bind="email" />
                    </div>
                    <div class="field">
                        <label class="label" for="o-phone">Teléfono</label>
                        <input id="o-phone" type="tel" class="input" @bind="phone" />
                    </div>
                </div>
                <span class="smaller muted">El correo y el teléfono se usan para avisarle de visitas y cambios de estado.</span>
                <ErrorAlert Exception="createError" />
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="RegisterAsync">@(company ? "Registrar persona jurídica" : "Registrar persona natural")</button>
            </section>
        }
    </div>
</div>

@code {
    private const int PageSize = 20;

    private static readonly (string? Key, string Label)[] TypeFilters = [(null, "Todos"), ("Natural", "Naturales"), ("Company", "Jurídicas")];

    private PagedResult<OwnerDto>? page;
    private IReadOnlyList<OwnerDto> owners = [];
    private bool loaded;
    private bool busy;
    private ApiException? error;
    private ApiException? createError;

    private string search = "";
    private string? typeFilter;
    private int currentPage = 1;

    private bool company;
    private string firstNames = "";
    private string lastNames = "";
    private DocumentType documentType = DocumentType.CitizenshipCard;
    private string documentNumber = "";
    private string legalName = "";
    private string nit = "";
    private string email = "";
    private string phone = "";

    private bool CanRegister => loaded && (Actor.IsStaff || owners.Count == 0);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            if (Actor.IsStaff)
            {
                page = await Api.ListAsync(null, string.IsNullOrWhiteSpace(search) ? null : search, typeFilter, currentPage, PageSize, CancellationToken.None);
                owners = page.Items;
            }
            else
            {
                owners = await LoadOwnRecordAsync();
            }

            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loaded = true;
        }
    }

    private async Task<IReadOnlyList<OwnerDto>> LoadOwnRecordAsync()
    {
        try
        {
            return [await Api.GetByIdAsync(Actor.Require(), CancellationToken.None)];
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            return [];
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task SetTypeAsync(string? type)
    {
        typeFilter = type;
        return RefreshAsync();
    }

    private Task GoToPageAsync(int target)
    {
        currentPage = target;
        return LoadAsync();
    }

    private async Task RegisterAsync()
    {
        busy = true;
        try
        {
            if (company)
                await Api.RegisterCompanyAsync(new RegisterCompanyOwnerRequest(legalName, nit, email, phone), CancellationToken.None);
            else
                await Api.RegisterNaturalAsync(
                    new RegisterNaturalOwnerRequest(firstNames, lastNames, documentType, documentNumber, email, phone), CancellationToken.None);

            firstNames = lastNames = documentNumber = legalName = nit = email = phone = "";
            createError = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            createError = ex;
        }
        finally
        {
            busy = false;
        }
    }
}
