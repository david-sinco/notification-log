@page "/rentals/owners"
@attribute [Authorize(Roles = $"{IdentityRoles.Administrador},{IdentityRoles.Moderador},{IdentityRoles.Propietario}")]
@inject OwnersApiClient Api
@inject RentalsActor Actor

<PageTitle>Propietarios · Llave</PageTitle>

<div class="page">
    <header class="page-head">
        <p class="eyebrow">Arriendos</p>
        <h1 class="title">Propietarios</h1>
        <p class="muted">Personas o empresas a cuyo nombre quedan las publicaciones.</p>
    </header>

    <ErrorAlert Exception="error" />

    <ClaimOwnerPrompt OnClaimed="LoadAsync" />

    <div class="split">
        <section class="stack" aria-label="Lista de propietarios" style="flex: 3 1 420px">
            @if (Actor.IsStaff)
            {
                <div class="row">
                    <label class="sr-only" for="owner-search">Buscar propietario</label>
                    <input id="owner-search" type="search" class="input input-search grow" style="--basis: 220px" placeholder="Nombre, correo o teléfono"
                           @bind="search" @bind:after="RefreshAsync" />
                </div>
            }

            @if (loaded && owners.Count == 0)
            {
                <EmptyState Text="@(Actor.IsStaff ? "No se encontraron propietarios." : "Todavía no estás registrado como propietario.")" />
            }

            <div class="stack" style="--gap: 10px">
                @foreach (var owner in owners)
                {
                    var isSelected = owner.Id == selected?.Id;
                    <button type="button" class="list-item @(isSelected ? "active" : "")" style="flex-direction: row; align-items: center; gap: 14px"
                            aria-pressed="@(isSelected ? "true" : "false")" @onclick="() => Select(owner)">
                        <span class="avatar avatar-lime" aria-hidden="true">@RentalsFormat.Initials(owner.Name)</span>
                        <span class="stack grow" style="--gap: 2px">
                            <span class="strong">@owner.Name</span>
                            <span class="small muted wrap-any">@owner.Email · @owner.Phone</span>
                        </span>
                        <span class="small strong">@ListingCount(owner)</span>
                    </button>
                }
            </div>

            @if (page is { TotalPages: > 1 })
            {
                <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" Shown="page.Items.Count" Noun="propietarios" OnPageChange="GoToPageAsync" />
            }
        </section>

        @if (selected is not null)
        {
            <section class="card" aria-label="Detalle del propietario" style="flex: 2 1 320px; --gap: 16px">
                <div class="page-head">
                    <span class="id">@RentalsFormat.Short(selected.Id)</span>
                    <h2 class="h2">@selected.Name</h2>
                </div>

                <div class="grid-auto" style="--min: 160px; --gap: 10px">
                    <div class="fact fact-box"><span class="fact-label">Correo</span><span class="fact-value wrap-any">@selected.Email</span></div>
                    <div class="fact fact-box"><span class="fact-label">Teléfono</span><span class="fact-value">@selected.Phone</span></div>
                    <div class="fact fact-box"><span class="fact-label">Registrado</span><span class="fact-value">@RentalsFormat.Moment(selected.RegisteredAt)</span></div>
                    <div class="fact fact-box"><span class="fact-label">Registró</span><span class="fact-value">@(Actor.Is(selected.CreatedBy) ? "Tú" : RentalsFormat.Short(selected.CreatedBy))</span></div>
                    <div class="fact fact-box"><span class="fact-label">Usuario</span><span class="fact-value">@UserLabel(selected)</span></div>
                    <div class="fact fact-box"><span class="fact-label">Publicaciones</span><span class="fact-value">@selected.ListingCount</span></div>
                </div>

                <div class="row">
                    <a class="btn" href="rentals/listings">Ver publicaciones</a>
                    @if (CanRegister)
                    {
                        <button type="button" class="btn btn-primary" @onclick="() => selected = null">Nuevo propietario</button>
                    }
                </div>
            </section>
        }
        else if (CanRegister)
        {
            <section class="card" aria-label="Registrar propietario" style="flex: 2 1 320px; --gap: 16px">
                <h2 class="h2">Registrar propietario</h2>
                <div class="grid-auto" style="--min: 190px; --gap: 14px">
                    <div class="field">
                        <label class="label" for="o-name">Nombre</label>
                        <input id="o-name" class="input" placeholder="Persona o empresa" @bind="name" />
                    </div>
                    <div class="field">
                        <label class="label" for="o-email">Correo</label>
                        <input id="o-email" type="email" class="input" @bind="email" />
                    </div>
                    <div class="field">
                        <label class="label" for="o-phone">Teléfono</label>
                        <input id="o-phone" type="tel" class="input" @bind="phone" />
                    </div>
                </div>
                <span class="smaller muted">El correo y el teléfono identifican al propietario y se usan para avisarle de visitas y cambios de estado.</span>
                <ErrorAlert Exception="createError" />
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="RegisterAsync">Registrar propietario</button>
            </section>
        }
    </div>
</div>

@code {
    private const int PageSize = 20;

    private PagedResult<OwnerDto>? page;
    private IReadOnlyList<OwnerDto> owners = [];
    private bool loaded;
    private bool busy;
    private ApiException? error;
    private ApiException? createError;
    private OwnerDto? selected;

    private string search = "";
    private int currentPage = 1;

    private string name = "";
    private string email = "";
    private string phone = "";

    private bool CanRegister => loaded && (Actor.IsStaff || owners.Count == 0);

    private static string ListingCount(OwnerDto owner)
        => $"{owner.ListingCount} {(owner.ListingCount == 1 ? "publicación" : "publicaciones")}";

    private string UserLabel(OwnerDto owner) => owner.RelatedUserId switch
    {
        null => "Sin reclamar",
        { } id when Actor.Is(id) => "Tú",
        { } id => RentalsFormat.Short(id)
    };

    private void Select(OwnerDto owner) => selected = owner;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        try
        {
            if (Actor.IsStaff)
            {
                page = await Api.ListAsync(null, string.IsNullOrWhiteSpace(search) ? null : search, currentPage, PageSize, CancellationToken.None);
                owners = page.Items;
            }
            else
            {
                owners = await LoadOwnRecordAsync();
            }

            selected = owners.FirstOrDefault(owner => owner.Id == selected?.Id);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loaded = true;
        }
    }

    private Task<IReadOnlyList<OwnerDto>> LoadOwnRecordAsync() => Api.ListMineAsync(CancellationToken.None);

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoToPageAsync(int target)
    {
        currentPage = target;
        return LoadAsync();
    }

    private async Task RegisterAsync()
    {
        busy = true;
        try
        {
            await Api.RegisterAsync(new RegisterOwnerRequest(name, email, phone), CancellationToken.None);

            name = email = phone = "";
            createError = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            createError = ex;
        }
        finally
        {
            busy = false;
        }
    }
}
