@page "/rentals/owners/{Id:guid}"
@attribute [Authorize(Roles = $"{IdentityRoles.Administrador},{IdentityRoles.Moderador},{IdentityRoles.Propietario}")]
@inject OwnersApiClient Api
@inject ListingsApiClient ListingsApi
@inject NavigationManager Nav

<PageTitle>Propietario · Llave</PageTitle>

<a href="/rentals/owners" class="back-link">← Volver a propietarios</a>

@if (loading)
{
    <div class="p-5 text-center text-muted">Cargando…</div>
}
else if (error is not null)
{
    <ErrorAlert Exception="error" />
}
else if (owner is not null)
{
    <div class="page-header">
        <div>
            <p class="eyebrow">@OwnerLabels.Type(owner.Type)</p>
            <h1>@OwnerLabels.Name(owner)</h1>
            <p>@OwnerLabels.Identification(owner)</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="surface-card h-100">
                <h2>Datos del propietario</h2>
                <dl class="kv-list">
                    @if (owner.Nit is not null)
                    {
                        <dt>Razón social</dt>
                        <dd>@owner.LegalName</dd>
                        <dt>NIT</dt>
                        <dd>@owner.Nit</dd>
                    }
                    else
                    {
                        <dt>Nombres</dt>
                        <dd>@owner.FirstNames</dd>
                        <dt>Apellidos</dt>
                        <dd>@owner.LastNames</dd>
                        <dt>Documento</dt>
                        <dd>@OwnerLabels.Document(owner.DocumentType) @owner.DocumentNumber</dd>
                    }
                </dl>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="surface-card h-100">
                <h2>Registro</h2>
                <dl class="kv-list">
                    <dt>Identificador</dt>
                    <dd><ShortId Value="owner.Id" /></dd>
                    <dt>Registrado por</dt>
                    <dd><ShortId Value="owner.CreatedBy" /></dd>
                    <dt>Fecha</dt>
                    <dd>@RentalsFormat.Date(owner.RegisteredAt)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="table-card">
        <div class="card-title-row">
            <h2>Publicaciones de este propietario</h2>
            <a href="/rentals/listings" class="small">Ver todas →</a>
        </div>

        @if (listings is { Count: 0 })
        {
            <EmptyState Text="Este propietario todavía no tiene publicaciones." Icon="🏠" />
        }
        else if (listings is not null)
        {
            <div class="table-responsive-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>Inmueble</th>
                            <th>Operación</th>
                            <th>Precio</th>
                            <th>Estado</th>
                            <th>Actualizada</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var listing in listings)
                        {
                            <tr class="row-link" @onclick='() => Nav.NavigateTo($"/rentals/listings/{listing.Id}")'>
                                <td>@RentalsFormat.ListingTitle(listing.Type, listing.Neighborhood, listing.City)</td>
                                <td>@RentalsFormat.Term(listing.Operation)</td>
                                <td>@RentalsFormat.Money(listing.Price)</td>
                                <td><RentalStatusPill Status="@listing.Status" /></td>
                                <td class="text-muted small">@RentalsFormat.Date(listing.UpdatedAt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private OwnerDto? owner;
    private IReadOnlyList<ListingSummaryDto>? listings;
    private bool loading = true;
    private ApiException? error;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            owner = await Api.GetByIdAsync(Id, CancellationToken.None);
            listings = (await ListingsApi.ListAsync(null, null, null, Id, 1, 10, CancellationToken.None)).Items;
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }
}
