@page "/"
@using System.Globalization
@inject DashboardApiClient DashboardApi
@inject RentalsActor Actor

<PageTitle>Panel · Llave</PageTitle>

<div class="page" style="gap: 28px">
    <header class="page-head" style="gap: 8px">
        <p class="eyebrow">@RentalsFormat.Today.ToString("dddd d 'de' MMMM", CultureInfo.GetCultureInfo("es-CO"))</p>
        <h1 class="title title-hero">@Greeting</h1>
        <p class="muted" style="max-width: 620px">Del anuncio a la entrega de la llave: publicaciones, visitas y los avisos que salen en cada paso.</p>
    </header>

    <ErrorAlert Exception="rentalsError" />

    <section class="grid-auto" aria-label="Pendientes" style="--min: 280px; --gap: 14px">
        <a class="queue-card queue-card-ink" href="@(Actor.IsStaff ? "rentals/moderation" : "rentals/listings")">
            <span class="row row-baseline">
                <span class="queue-count">@Count(dashboard?.InReview)</span>
                <span class="strong">publicaciones en revisión</span>
            </span>
            <span>@InReviewText</span>
            <span class="small strong">@(Actor.IsStaff ? "Abrir moderación" : "Ver publicaciones") →</span>
        </a>
        <a class="queue-card queue-card-lime" href="rentals/visits">
            <span class="row row-baseline">
                <span class="queue-count">@Count(dashboard?.VisitsAwaitingHost)</span>
                <span class="strong">visitas por responder</span>
            </span>
            <span>@VisitsText</span>
            <span class="small strong">Responder visitas →</span>
        </a>
        <a class="queue-card" href="rentals/listings">
            <span class="row row-baseline">
                <span class="queue-count">@Count(dashboard?.MyDrafts)</span>
                <span class="strong">borradores tuyos</span>
            </span>
            <span>Necesitan datos, precio y al menos @ListingLimits.MinPhotos fotos para enviarse a revisión.</span>
            <span class="small strong">Completar borradores →</span>
        </a>
    </section>

    <section class="stats" aria-label="Resumen">
        <a class="stat" href="rentals/listings"><span class="smaller muted">Publicadas</span><span class="stat-value">@Count(dashboard?.Published)</span></a>
        @if (Actor.IsStaff)
        {
            <a class="stat" href="rentals/owners"><span class="smaller muted">Propietarios</span><span class="stat-value">@Count(dashboard?.Owners)</span></a>
        }
        else
        {
            <a class="stat" href="rentals/listings"><span class="smaller muted">Cerradas</span><span class="stat-value">@Count(dashboard?.Closed)</span></a>
        }
        <a class="stat" href="rentals/visits"><span class="smaller muted">Visitas</span><span class="stat-value">@Count(dashboard?.Visits)</span></a>
    </section>

    <div class="split">
        <section class="card card-tight" style="flex: 3 1 420px; --gap: 12px">
            <div class="row row-between row-baseline">
                <h2 class="h2 h2-sm">Publicaciones con actividad reciente</h2>
                <a class="small strong" href="rentals/listings">Ver todas</a>
            </div>
            @if (dashboard is { RecentListings.Count: 0 })
            {
                <EmptyState Text="Todavía no hay publicaciones." />
            }
            else if (dashboard is not null)
            {
                <div>
                    @foreach (var listing in dashboard.RecentListings)
                    {
                        <a class="line-row" href="rentals/listings/@listing.Id" style="gap: 12px; padding: 12px 0">
                            @if (listing.CoverUrl is null)
                            {
                                <span class="thumb">sin foto</span>
                            }
                            else
                            {
                                <img class="thumb" src="@listing.CoverUrl" alt="" />
                            }
                            <span class="stack grow" style="--gap: 0; --basis: 180px">
                                <span class="strong">@RentalsFormat.ListingTitle(listing.Type, listing.Neighborhood, listing.City)</span>
                                <span class="smaller muted">@RentalsFormat.Term(listing.Operation) · @Facts(listing)</span>
                            </span>
                            <span class="strong">@RentalsFormat.Money(listing.Price)</span>
                            <RentalStatusPill Status="@listing.Status" />
                        </a>
                    }
                </div>
            }
        </section>

        <section class="card card-tight" style="flex: 2 1 300px; --gap: 12px">
            <div class="row row-between row-baseline">
                <h2 class="h2 h2-sm">Últimas visitas</h2>
                <a class="small strong" href="rentals/visits">Ver todas</a>
            </div>
            @if (dashboard is { RecentVisits.Count: 0 })
            {
                <EmptyState Text="Todavía no hay visitas." />
            }
            else if (dashboard is not null)
            {
                <div>
                    @foreach (var visit in dashboard.RecentVisits)
                    {
                        <a class="line-row" href="rentals/visits/@visit.Id" style="gap: 12px; padding: 11px 0">
                            <span class="stack grow" style="--gap: 0; --basis: 0">
                                <span class="strong">@RentalsFormat.ListingTitle(visit.ListingType, visit.ListingNeighborhood, visit.ListingCity)</span>
                                <span class="smaller muted wrap-any">@visit.VisitorName · @VisitWhen(visit)</span>
                            </span>
                            <RentalStatusPill Status="@visit.Status" />
                        </a>
                    }
                </div>
            }
        </section>
    </div>

    <section class="card card-tight" style="--gap: 16px">
        <h2 class="h2 h2-sm">El recorrido de una publicación</h2>
        <ol class="grid-auto">
            <li class="step">
                <span class="mono smaller muted">Paso 1</span>
                <span class="strong">Registra al propietario</span>
                <span class="small muted">Persona natural o jurídica.</span>
                <a class="small strong" href="rentals/owners">Ir a propietarios</a>
            </li>
            <li class="step">
                <span class="mono smaller muted">Paso 2</span>
                <span class="strong">Crea la publicación</span>
                <span class="small muted">Datos, precio y al menos @ListingLimits.MinPhotos fotos.</span>
                <a class="small strong" href="rentals/listings">Nueva publicación</a>
            </li>
            <li class="step">
                <span class="mono smaller muted">Paso 3</span>
                <span class="strong">Apruébala</span>
                <span class="small muted">Desde la cola de moderación.</span>
                <a class="small strong" href="rentals/moderation">Ir a moderación</a>
            </li>
            <li class="step">
                <span class="mono smaller muted">Paso 4</span>
                <span class="strong">Agenda la visita</span>
                <span class="small muted">Y cierra el negocio cuando se firme.</span>
                <a class="small strong" href="rentals/visits">Ver visitas</a>
            </li>
        </ol>
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private ApiException? rentalsError;
    private string greetingName = "";

    private DashboardDto? dashboard;

    private int Pending => dashboard is null ? 0 : dashboard.InReview + dashboard.VisitsAwaitingHost + dashboard.MyDrafts;

    private string Greeting
    {
        get
        {
            var hello = string.IsNullOrWhiteSpace(greetingName) ? "Hola." : $"Hola, {greetingName}.";

            return Pending switch
            {
                0 => $"{hello} Todo está al día.",
                1 => $"{hello} Hay 1 cosa esperándote.",
                _ => $"{hello} Hay {Pending} cosas esperándote."
            };
        }
    }

    private string InReviewText => dashboard?.OldestInReviewSince is { } since
        ? $"La más antigua espera desde el {RentalsFormat.Moment(since)}."
        : "Ninguna publicación espera aprobación.";

    private string VisitsText => dashboard?.NextVisitRespondBy is { } respondBy
        ? $"La próxima vence el {RentalsFormat.Moment(respondBy)} si nadie responde."
        : "Ningún anfitrión tiene solicitudes pendientes.";

    private static string Count(int? value) => value?.ToString() ?? "—";

    private static string Facts(ListingSummaryDto listing) =>
        listing.Bedrooms is null ? "sin datos todavía" : $"{listing.Bedrooms} hab · {listing.Area:0.#} m²";

    private static string VisitWhen(VisitDto visit) =>
        visit.FirstSlot is { } slot ? RentalsFormat.Moment(slot) : "sin franja";

    protected override async Task OnInitializedAsync()
    {
        greetingName = (await AuthState).User.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

        await LoadRentalsAsync();
    }

    private async Task LoadRentalsAsync()
    {
        try
        {
            dashboard = await DashboardApi.GetAsync(CancellationToken.None);
        }
        catch (ApiException ex)
        {
            rentalsError = ex;
        }
    }
}
