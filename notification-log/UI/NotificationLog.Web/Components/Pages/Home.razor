@page "/"
@using System.Globalization
@inject ListingsApiClient ListingsApi
@inject VisitsApiClient VisitsApi
@inject OwnersApiClient OwnersApi
@inject TriggersApiClient TriggersApi
@inject TemplatesApiClient TemplatesApi
@inject RecipientsApiClient RecipientsApi
@inject NotificationsApiClient NotificationsApi
@inject RentalsActor Actor

<PageTitle>Panel · Llave</PageTitle>

<div class="page" style="gap: 28px">
    <header class="page-head" style="gap: 8px">
        <p class="eyebrow">@RentalsFormat.Today.ToString("dddd d 'de' MMMM", CultureInfo.GetCultureInfo("es-CO"))</p>
        <h1 class="title title-hero">@Greeting</h1>
        <p class="muted" style="max-width: 620px">Del anuncio a la entrega de la llave: publicaciones, visitas y los avisos que salen en cada paso.</p>
    </header>

    <ErrorAlert Exception="rentalsError" />

    <section class="grid-auto" aria-label="Pendientes" style="--min: 280px; --gap: 14px">
        <a class="queue-card queue-card-ink" href="@(Actor.IsStaff ? "rentals/moderation" : "rentals/listings")">
            <span class="row row-baseline">
                <span class="queue-count">@Count(inReview?.TotalCount)</span>
                <span class="strong">publicaciones en revisión</span>
            </span>
            <span>@InReviewText</span>
            <span class="small strong">@(Actor.IsStaff ? "Abrir moderación" : "Ver publicaciones") →</span>
        </a>
        <a class="queue-card queue-card-lime" href="rentals/visits">
            <span class="row row-baseline">
                <span class="queue-count">@Count(awaitingVisits?.TotalCount)</span>
                <span class="strong">visitas por responder</span>
            </span>
            <span>@VisitsText</span>
            <span class="small strong">Responder visitas →</span>
        </a>
        <a class="queue-card" href="rentals/listings">
            <span class="row row-baseline">
                <span class="queue-count">@Count(drafts)</span>
                <span class="strong">borradores tuyos</span>
            </span>
            <span>Necesitan datos, precio y al menos @ListingLimits.MinPhotos fotos para enviarse a revisión.</span>
            <span class="small strong">Completar borradores →</span>
        </a>
    </section>

    <ErrorAlert Exception="notificationsError" />

    <section class="stats" aria-label="Resumen">
        <a class="stat" href="rentals/listings"><span class="smaller muted">Publicadas</span><span class="stat-value">@Count(published)</span></a>
        @if (Actor.IsStaff)
        {
            <a class="stat" href="rentals/owners"><span class="smaller muted">Propietarios</span><span class="stat-value">@Count(owners)</span></a>
        }
        else
        {
            <a class="stat" href="rentals/listings"><span class="smaller muted">Cerradas</span><span class="stat-value">@Count(closed)</span></a>
        }
        <a class="stat" href="triggers"><span class="smaller muted">Triggers</span><span class="stat-value">@Count(triggers)</span></a>
        <a class="stat" href="templates"><span class="smaller muted">Plantillas</span><span class="stat-value">@Count(templates)</span></a>
        <a class="stat" href="recipients"><span class="smaller muted">Destinatarios</span><span class="stat-value">@Count(recipients)</span></a>
        <a class="stat" href="notifications"><span class="smaller muted">Envíos</span><span class="stat-value">@Count(notifications?.TotalCount)</span></a>
    </section>

    <div class="split">
        <section class="card card-tight" style="flex: 3 1 420px; --gap: 12px">
            <div class="row row-between row-baseline">
                <h2 class="h2 h2-sm">Publicaciones con actividad reciente</h2>
                <a class="small strong" href="rentals/listings">Ver todas</a>
            </div>
            @if (recentListings is { Count: 0 })
            {
                <EmptyState Text="Todavía no hay publicaciones." />
            }
            else if (recentListings is not null)
            {
                <div>
                    @foreach (var listing in recentListings)
                    {
                        <a class="line-row" href="rentals/listings/@listing.Id" style="gap: 12px; padding: 12px 0">
                            @if (listing.CoverUrl is null)
                            {
                                <span class="thumb">sin foto</span>
                            }
                            else
                            {
                                <img class="thumb" src="@listing.CoverUrl" alt="" />
                            }
                            <span class="stack grow" style="--gap: 0; --basis: 180px">
                                <span class="strong">@RentalsFormat.ListingTitle(listing.Type, listing.Neighborhood, listing.City)</span>
                                <span class="smaller muted">@RentalsFormat.Term(listing.Operation) · @Facts(listing)</span>
                            </span>
                            <span class="strong">@RentalsFormat.Money(listing.Price)</span>
                            <RentalStatusPill Status="@listing.Status" />
                        </a>
                    }
                </div>
            }
        </section>

        <section class="card card-tight" style="flex: 2 1 300px; --gap: 12px">
            <div class="row row-between row-baseline">
                <h2 class="h2 h2-sm">Últimos envíos</h2>
                <a class="small strong" href="notifications">Ver historial</a>
            </div>
            @if (notifications is { Items.Count: 0 })
            {
                <EmptyState Text="Todavía no se envió ninguna notificación." />
            }
            else if (notifications is not null)
            {
                <div>
                    @foreach (var notification in notifications.Items)
                    {
                        var sent = notification.Status == nameof(DeliveryStatus.Sent);
                        <div class="line-row" style="flex-wrap: nowrap; padding: 11px 0">
                            <span class="dot @(sent ? "" : "dot-danger")" aria-hidden="true"></span>
                            <span class="stack grow" style="--gap: 0; --basis: 0">
                                <span class="event-key smaller">@notification.EventKey</span>
                                <span class="smaller muted wrap-any">@ChannelLabels.Name(notification.Channel) · @notification.Destination</span>
                            </span>
                            <span class="smaller strong @(sent ? "text-success" : "text-danger")">@(sent ? "Enviado" : "Falló")</span>
                        </div>
                    }
                </div>
            }
        </section>
    </div>

    <section class="card card-tight" style="--gap: 16px">
        <h2 class="h2 h2-sm">El recorrido de una publicación</h2>
        <ol class="grid-auto">
            <li class="step">
                <span class="mono smaller muted">Paso 1</span>
                <span class="strong">Registra al propietario</span>
                <span class="small muted">Persona natural o jurídica.</span>
                <a class="small strong" href="rentals/owners">Ir a propietarios</a>
            </li>
            <li class="step">
                <span class="mono smaller muted">Paso 2</span>
                <span class="strong">Crea la publicación</span>
                <span class="small muted">Datos, precio y al menos @ListingLimits.MinPhotos fotos.</span>
                <a class="small strong" href="rentals/listings">Nueva publicación</a>
            </li>
            <li class="step">
                <span class="mono smaller muted">Paso 3</span>
                <span class="strong">Apruébala</span>
                <span class="small muted">Desde la cola de moderación.</span>
                <a class="small strong" href="rentals/moderation">Ir a moderación</a>
            </li>
            <li class="step">
                <span class="mono smaller muted">Paso 4</span>
                <span class="strong">Agenda la visita</span>
                <span class="small muted">Y cierra el negocio cuando se firme.</span>
                <a class="small strong" href="rentals/visits">Ver visitas</a>
            </li>
        </ol>
    </section>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private ApiException? rentalsError;
    private ApiException? notificationsError;
    private string greetingName = "";

    private PagedResult<ListingSummaryDto>? inReview;
    private PagedResult<VisitDto>? awaitingVisits;
    private IReadOnlyList<ListingSummaryDto>? recentListings;
    private PagedResult<NotificationDto>? notifications;
    private int? drafts;
    private int? published;
    private int? owners;
    private int? closed;
    private int? triggers;
    private int? templates;
    private int? recipients;

    private int Pending => (inReview?.TotalCount ?? 0) + (awaitingVisits?.TotalCount ?? 0) + (drafts ?? 0);

    private string Greeting
    {
        get
        {
            var hello = string.IsNullOrWhiteSpace(greetingName) ? "Hola." : $"Hola, {greetingName}.";

            return Pending switch
            {
                0 => $"{hello} Todo está al día.",
                1 => $"{hello} Hay 1 cosa esperándote.",
                _ => $"{hello} Hay {Pending} cosas esperándote."
            };
        }
    }

    private string InReviewText => inReview is { Items.Count: > 0 }
        ? $"La más antigua espera desde el {RentalsFormat.Moment(inReview.Items.Min(listing => listing.UpdatedAt))}."
        : "Ninguna publicación espera aprobación.";

    private string VisitsText => awaitingVisits?.Items.Where(visit => visit.RespondBy is not null).Select(visit => visit.RespondBy).Min() is { } respondBy
        ? $"La próxima vence el {RentalsFormat.Moment(respondBy)} si nadie responde."
        : "Ningún anfitrión tiene solicitudes pendientes.";

    private static string Count(int? value) => value?.ToString() ?? "—";

    private static string Facts(ListingSummaryDto listing) =>
        listing.Bedrooms is null ? "sin datos todavía" : $"{listing.Bedrooms} hab · {listing.Area:0.#} m²";

    protected override async Task OnInitializedAsync()
    {
        greetingName = (await AuthState).User.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";

        await Task.WhenAll(LoadRentalsAsync(), LoadNotificationsAsync());
    }

    private async Task LoadRentalsAsync()
    {
        try
        {
            var none = CancellationToken.None;
            var inReviewTask = ListingsApi.ListAsync(null, ListingStatus.InReview, null, null, 1, 50, none);
            var publishedTask = ListingsApi.ListAsync(null, ListingStatus.Published, null, null, 1, 1, none);
            var draftsTask = ListingsApi.ListAsync(null, ListingStatus.Draft, null, Actor.Id ?? Guid.Empty, 1, 1, none);
            var recentTask = ListingsApi.ListAsync(null, null, null, null, 1, 5, none);
            var visitsTask = VisitsApi.ListAsync(null, null, VisitStatus.AwaitingHost, 1, 50, none);
            var ownersTask = Actor.IsStaff ? OwnersApi.ListAsync(null, null, null, 1, 1, none) : null;
            var closedTask = Actor.IsStaff ? null : ListingsApi.ListAsync(null, ListingStatus.Closed, null, null, 1, 1, none);

            await Task.WhenAll(inReviewTask, publishedTask, draftsTask, recentTask, visitsTask);

            inReview = inReviewTask.Result;
            published = publishedTask.Result.TotalCount;
            drafts = draftsTask.Result.TotalCount;
            recentListings = recentTask.Result.Items;
            awaitingVisits = visitsTask.Result;

            owners = ownersTask is null ? null : (await ownersTask).TotalCount;
            closed = closedTask is null ? null : (await closedTask).TotalCount;
        }
        catch (ApiException ex)
        {
            rentalsError = ex;
        }
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            var none = CancellationToken.None;
            var triggersTask = TriggersApi.ListAsync(null, null, 1, 1, none);
            var templatesTask = TemplatesApi.ListAsync(null, null, null, 1, 1, none);
            var recipientsTask = RecipientsApi.ListAsync(null, null, 1, 1, none);
            var notificationsTask = NotificationsApi.ListAsync(null, null, null, null, 1, 5, none);

            await Task.WhenAll(triggersTask, templatesTask, recipientsTask, notificationsTask);

            triggers = triggersTask.Result.TotalCount;
            templates = templatesTask.Result.TotalCount;
            recipients = recipientsTask.Result.TotalCount;
            notifications = notificationsTask.Result;
        }
        catch (ApiException ex)
        {
            notificationsError = ex;
        }
    }
}
