@page "/"
@inject ListingsApiClient ListingsApi
@inject VisitsApiClient VisitsApi
@inject OwnersApiClient OwnersApi
@inject TriggersApiClient TriggersApi
@inject TemplatesApiClient TemplatesApi
@inject RecipientsApiClient RecipientsApi
@inject NotificationsApiClient NotificationsApi
@inject NavigationManager Nav

<PageTitle>Panel · Llave</PageTitle>

<div class="page-header">
    <div>
        <p class="eyebrow">Llave · Backoffice</p>
        <h1>@Greeting</h1>
        <p>Del anuncio a la entrega de la llave: publicaciones, visitas y los avisos que salen en cada paso.</p>
    </div>
</div>

<h2 class="section-title">Arriendos</h2>

@if (rentalsError is not null)
{
    <ErrorAlert Exception="rentalsError" />
}

<div class="row g-3 mb-5">
    <div class="col-6 col-lg-3">
        <a class="stat-card stat-accent" href="rentals/moderation">
            <span class="stat-icon">🛡️</span>
            <span class="stat-label">En revisión</span>
            <span class="stat-value">@Count(inReview)</span>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="stat-card" href="rentals/listings">
            <span class="stat-icon">🏢</span>
            <span class="stat-label">Publicadas</span>
            <span class="stat-value">@Count(published)</span>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="stat-card" href="rentals/visits">
            <span class="stat-icon">📅</span>
            <span class="stat-label">Visitas por confirmar</span>
            <span class="stat-value">@Count(requestedVisits)</span>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        @if (isStaff)
        {
            <a class="stat-card" href="rentals/owners">
                <span class="stat-icon">🔑</span>
                <span class="stat-label">Propietarios</span>
                <span class="stat-value">@Count(owners)</span>
            </a>
        }
        else
        {
            <a class="stat-card" href="rentals/listings">
                <span class="stat-icon">🤝</span>
                <span class="stat-label">Cerradas</span>
                <span class="stat-value">@Count(closed)</span>
            </a>
        }
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-lg-8">
        <div class="table-card">
            <div class="card-title-row">
                <h2>Publicaciones con actividad reciente</h2>
                <a href="rentals/listings" class="small">Ver todo →</a>
            </div>

            @if (loadingRentals)
            {
                <div class="p-4 text-center text-muted">Cargando…</div>
            }
            else if (recentListings is { Count: 0 })
            {
                <EmptyState Text="Todavía no hay publicaciones." Icon="🏠" />
            }
            else if (recentListings is not null)
            {
                <div class="table-responsive-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Inmueble</th>
                                <th>Precio</th>
                                <th>Estado</th>
                                <th>Actualizada</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var listing in recentListings)
                            {
                                <tr class="row-link" @onclick='() => Nav.NavigateTo($"/rentals/listings/{listing.Id}")'>
                                    <td>@RentalsFormat.ListingTitle(listing.Type, listing.Neighborhood, listing.City)</td>
                                    <td>@RentalsFormat.Money(listing.Price)</td>
                                    <td><RentalStatusPill Status="@listing.Status" /></td>
                                    <td class="text-muted small">@RentalsFormat.Date(listing.UpdatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="surface-card h-100">
            <h2>Para empezar</h2>
            <ol class="steps">
                <li>
                    <span class="step-number">1</span>
                    <div>
                        <strong>Registra al propietario</strong>
                        Persona natural o jurídica en <a href="rentals/owners">Propietarios</a>.
                    </div>
                </li>
                <li>
                    <span class="step-number">2</span>
                    <div>
                        <strong>Crea la publicación</strong>
                        Complétala y envíala a revisión.
                    </div>
                </li>
                <li>
                    <span class="step-number">3</span>
                    <div>
                        <strong>Apruébala</strong>
                        Desde la cola de <a href="rentals/moderation">Moderación</a>.
                    </div>
                </li>
                <li>
                    <span class="step-number">4</span>
                    <div>
                        <strong>Agenda la visita</strong>
                        Y ciérrala cuando se arriende o se venda.
                    </div>
                </li>
            </ol>
        </div>
    </div>
</div>

<h2 class="section-title">Notificaciones</h2>

@if (notificationsError is not null)
{
    <ErrorAlert Exception="notificationsError" />
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="table-card">
            <div class="card-title-row">
                <h2>Últimos envíos</h2>
                <a href="notifications" class="small">Ver todo →</a>
            </div>

            @if (loadingNotifications)
            {
                <div class="p-4 text-center text-muted">Cargando…</div>
            }
            else if (recentNotifications is { Count: 0 })
            {
                <EmptyState Text="Todavía no se envió ninguna notificación." Icon="🔕" />
            }
            else if (recentNotifications is not null)
            {
                <div class="table-responsive-wrap">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Evento</th>
                                <th>Canal</th>
                                <th>Destino</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var notification in recentNotifications)
                            {
                                <tr>
                                    <td><code>@notification.EventKey</code></td>
                                    <td><ChannelBadge Channel="@notification.Channel" /></td>
                                    <td>@notification.Destination</td>
                                    <td>
                                        <StatusPill Text="@notification.Status"
                                                    Variant="@(notification.Status == "Sent" ? "success" : "danger")" />
                                    </td>
                                    <td class="text-muted small">@notification.OccurredAt.ToLocalTime().ToString("g")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="surface-card h-100">
            <h2>Configuración</h2>
            <ul class="mini-stats">
                <li>
                    <a href="triggers"><span>Triggers</span><strong>@Count(triggers)</strong></a>
                </li>
                <li>
                    <a href="templates"><span>Plantillas</span><strong>@Count(templates)</strong></a>
                </li>
                <li>
                    <a href="recipients"><span>Destinatarios</span><strong>@Count(recipients)</strong></a>
                </li>
                <li>
                    <a href="notifications"><span>Envíos registrados</span><strong>@Count(notifications)</strong></a>
                </li>
            </ul>
        </div>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = null!;

    private bool loadingRentals = true;
    private bool loadingNotifications = true;
    private bool isStaff;
    private ApiException? rentalsError;
    private ApiException? notificationsError;
    private string greetingName = "";

    private int? inReview;
    private int? published;
    private int? requestedVisits;
    private int? owners;
    private int? closed;
    private int? triggers;
    private int? templates;
    private int? recipients;
    private int? notifications;

    private IReadOnlyList<ListingSummaryDto>? recentListings;
    private IReadOnlyList<NotificationDto>? recentNotifications;

    private string Greeting => string.IsNullOrWhiteSpace(greetingName)
        ? "Panel"
        : $"Hola, {greetingName}";

    private static string Count(int? value) => value?.ToString() ?? "—";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;

        greetingName = user.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "";
        isStaff = user.IsInRole(IdentityRoles.Administrador) || user.IsInRole(IdentityRoles.Moderador);

        await Task.WhenAll(LoadRentalsAsync(), LoadNotificationsAsync());
    }

    private async Task LoadRentalsAsync()
    {
        try
        {
            var inReviewTask = ListingsApi.ListAsync(null, ListingStatus.InReview, null, null, 1, 1, CancellationToken.None);
            var publishedTask = ListingsApi.ListAsync(null, ListingStatus.Published, null, null, 1, 1, CancellationToken.None);
            var recentTask = ListingsApi.ListAsync(null, null, null, null, 1, 6, CancellationToken.None);
            var visitsTask = VisitsApi.ListAsync(null, null, VisitStatus.Requested, 1, 1, CancellationToken.None);
            var ownersTask = isStaff ? OwnersApi.ListAsync(null, 1, 1, CancellationToken.None) : null;
            var closedTask = isStaff
                ? null
                : ListingsApi.ListAsync(null, ListingStatus.Closed, null, null, 1, 1, CancellationToken.None);

            await Task.WhenAll(inReviewTask, publishedTask, recentTask, visitsTask);

            inReview = inReviewTask.Result.TotalCount;
            published = publishedTask.Result.TotalCount;
            recentListings = recentTask.Result.Items;
            requestedVisits = visitsTask.Result.TotalCount;
            owners = ownersTask is null ? null : (await ownersTask).TotalCount;
            closed = closedTask is null ? null : (await closedTask).TotalCount;
        }
        catch (ApiException ex)
        {
            rentalsError = ex;
        }
        finally
        {
            loadingRentals = false;
        }
    }

    private async Task LoadNotificationsAsync()
    {
        try
        {
            var triggersTask = TriggersApi.ListAsync(null, null, 1, 1, CancellationToken.None);
            var templatesTask = TemplatesApi.ListAsync(null, null, null, 1, 1, CancellationToken.None);
            var recipientsTask = RecipientsApi.ListAsync(null, null, 1, 1, CancellationToken.None);
            var notificationsTask = NotificationsApi.ListAsync(null, null, null, 1, 6, CancellationToken.None);

            await Task.WhenAll(triggersTask, templatesTask, recipientsTask, notificationsTask);

            triggers = triggersTask.Result.TotalCount;
            templates = templatesTask.Result.TotalCount;
            recipients = recipientsTask.Result.TotalCount;
            notifications = notificationsTask.Result.TotalCount;
            recentNotifications = notificationsTask.Result.Items;
        }
        catch (ApiException ex)
        {
            notificationsError = ex;
        }
        finally
        {
            loadingNotifications = false;
        }
    }
}
