<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated == true)
                {
                    <div class="page">
                        <EmptyState Text="No tienes permiso para ver esta página." />
                    </div>
                }
                else
                {
                    <RedirectToLogin />
                }
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.MainLayout)">
            <div class="page">
                <header class="page-head">
                    <p class="eyebrow">Llave</p>
                    <h1 class="title">No encontramos esa página</h1>
                    <p class="muted">Puede que el enlace esté viejo o que el recurso ya no exista.</p>
                </header>
                <a class="btn btn-primary btn-start" href="">Ir al panel</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>
