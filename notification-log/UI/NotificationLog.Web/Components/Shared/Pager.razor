<nav class="row row-between" aria-label="Paginación">
    <span class="small muted">@Shown de @TotalCount @Noun · página @Page de @TotalPages</span>
    <div class="row" style="--gap: 8px">
        <button type="button" class="btn btn-sm" disabled="@(Page <= 1)" @onclick="() => OnPageChange.InvokeAsync(Page - 1)">Anterior</button>
        <button type="button" class="btn btn-sm" disabled="@(Page >= TotalPages)" @onclick="() => OnPageChange.InvokeAsync(Page + 1)">Siguiente</button>
    </div>
</nav>

@code {
    [Parameter] public int Page { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int Shown { get; set; }
    [Parameter] public string Noun { get; set; } = "resultados";
    [Parameter] public EventCallback<int> OnPageChange { get; set; }
}
