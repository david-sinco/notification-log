<button type="button" class="switch" role="switch" aria-checked="@(Checked ? "true" : "false")" disabled="@Disabled" @onclick="OnToggle">
    <span class="switch-track" aria-hidden="true"><span class="switch-knob"></span></span>
    @(Checked ? OnLabel : OffLabel)
</button>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public string OnLabel { get; set; } = "Habilitado";
    [Parameter] public string OffLabel { get; set; } = "Deshabilitado";
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }
}
