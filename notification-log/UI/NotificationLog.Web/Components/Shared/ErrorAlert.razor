@if (Exception is not null)
{
    <div class="note note-danger" role="alert">
        <strong>@(Exception.Title ?? "No se pudo aplicar el cambio")</strong>
        <span>@Exception.Message</span>
        @if (Exception.FieldErrors is { Count: > 0 })
        {
            <ul>
                @foreach (var field in Exception.FieldErrors)
                {
                    @foreach (var message in field.Value)
                    {
                        <li><strong>@field.Key:</strong> @message</li>
                    }
                }
            </ul>
        }
    </div>
}

@code {
    [Parameter] public ApiException? Exception { get; set; }
}
