<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Cuentas</title>
    <style>
        body { font-family: system-ui, sans-serif; background: #f4f5f7; margin: 0; padding: 3rem 1rem; color: #1f2933; }
        main { max-width: 24rem; margin: 0 auto; background: #fff; border-radius: .5rem; padding: 2rem; box-shadow: 0 1px 3px rgba(0,0,0,.1); }
        h1 { font-size: 1.4rem; margin-top: 0; }
        label { display: block; margin: 1rem 0 .25rem; font-weight: 600; font-size: .9rem; }
        input { width: 100%; box-sizing: border-box; padding: .6rem; border: 1px solid #cbd2d9; border-radius: .35rem; font-size: 1rem; }
        button { margin-top: 1.5rem; width: 100%; padding: .7rem; border: 0; border-radius: .35rem; background: #2563eb; color: #fff; font-size: 1rem; cursor: pointer; }
        button.link { background: none; color: #2563eb; margin-top: .75rem; padding: 0; }
        .error { background: #fde8e8; color: #9b1c1c; padding: .6rem; border-radius: .35rem; margin-bottom: 1rem; }
        .info { background: #e1effe; color: #1e429f; padding: .6rem; border-radius: .35rem; margin-bottom: 1rem; }
        p.footer { margin-top: 1.5rem; font-size: .9rem; text-align: center; }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
