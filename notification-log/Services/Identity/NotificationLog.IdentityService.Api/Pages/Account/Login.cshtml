@page
@model NotificationLog.IdentityService.Api.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<h1>Iniciar sesión</h1>

@if (Model.Message is not null)
{
    <div class="info">@Model.Message</div>
}

@if (Model.Error is not null)
{
    <div class="error">@Model.Error</div>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="Identifier">Correo o teléfono</label>
    <input asp-for="Identifier" autocomplete="username" autofocus />

    <label asp-for="Password">Contraseña</label>
    <input asp-for="Password" type="password" autocomplete="current-password" />

    <button type="submit">Entrar</button>
</form>

<p class="footer">¿No tienes cuenta? <a asp-page="Register" asp-route-returnUrl="@Model.ReturnUrl">Crear cuenta</a></p>
