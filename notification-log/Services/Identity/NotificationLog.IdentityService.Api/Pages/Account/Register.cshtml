@page
@using NotificationLog.IdentityService.Api.Accounts
@model NotificationLog.IdentityService.Api.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Crear cuenta";
}

<p class="eyebrow">Cuentas Llave</p>
<h1>Crea tu cuenta</h1>
<p class="lead">Guarda favoritos, agenda visitas y publica tu apartamento cuando quieras.</p>

@if (Model.Error is not null)
{
    <div class="alert alert-error" role="alert">@Model.Error</div>
}

<form method="post">
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="field">
        <label asp-for="Name">Nombre</label>
        <input asp-for="Name" class="input" autocomplete="name" maxlength="@AccountPolicy.NameMaxLength" required autofocus />
    </div>

    <div class="field">
        <label asp-for="Identifier">Correo o celular</label>
        <input asp-for="Identifier" class="input" autocomplete="username" placeholder="nombre@correo.com o 300 123 4567" />
        <span class="hint">Te enviaremos un código para confirmarlo. Los celulares de Colombia no necesitan +57.</span>
    </div>

    <div class="field">
        <label asp-for="Password">Contraseña</label>
        <div class="password">
            <input asp-for="Password" type="password" class="input" autocomplete="new-password" />
            <button type="button" class="password-toggle" data-toggle-password="Password" aria-pressed="false">Mostrar</button>
        </div>
        <span class="hint">Mínimo 8 caracteres, con al menos una letra y un número.</span>
    </div>

    <div class="field">
        <label asp-for="ConfirmPassword">Confirma la contraseña</label>
        <input asp-for="ConfirmPassword" type="password" class="input" autocomplete="new-password" />
    </div>

    <div class="field">
        <label asp-for="Locale">Idioma</label>
        <select asp-for="Locale" class="input" asp-items="@(new SelectList(AccountPolicy.Locales, "Key", "Value"))"></select>
    </div>

    <div class="field">
        <label asp-for="TimeZone">Zona horaria</label>
        <select asp-for="TimeZone" class="input" asp-items="@(new SelectList(AccountPolicy.TimeZones, "Key", "Value"))"></select>
        <span class="hint">La usamos para mostrarte fechas y horas en tu horario local.</span>
    </div>

    <label class="checkbox">
        <input asp-for="AcceptsNotifications" required />
        <span>Autorizo a Llave a enviarme notificaciones por cualquier medio: correo, SMS, WhatsApp o push.</span>
    </label>

    <button type="submit" class="button">Crear cuenta</button>

    <p class="legal">Al crear tu cuenta autorizas el tratamiento de tus datos personales para gestionar tu acceso a Llave.</p>
</form>

<div class="divider"></div>

<p class="switch">¿Ya tienes cuenta? <a asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">Inicia sesión</a></p>
