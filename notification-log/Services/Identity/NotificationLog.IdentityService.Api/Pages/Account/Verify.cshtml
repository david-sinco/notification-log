@page
@model NotificationLog.IdentityService.Api.Pages.Account.VerifyModel
@{
    ViewData["Title"] = "Verificar cuenta";
}

<h1>Verifica tu cuenta</h1>

@if (Model.Message is not null)
{
    <div class="info">@Model.Message</div>
}

@if (Model.Error is not null)
{
    <div class="error">@Model.Error</div>
}

<p>Enviamos un código a <strong>@Model.Identifier</strong>.</p>

<form method="post">
    <input type="hidden" asp-for="Identifier" />
    <input type="hidden" asp-for="ReturnUrl" />

    <label asp-for="Code">Código</label>
    <input asp-for="Code" inputmode="numeric" autocomplete="one-time-code" autofocus />

    <button type="submit">Verificar</button>
    <button type="submit" class="link" asp-page-handler="Resend">Enviar otro código</button>
</form>
