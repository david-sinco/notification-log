@page
@model NotificationLog.IdentityService.Api.Pages.Account.VerifyModel
@{
    ViewData["Title"] = "Verificar cuenta";
    var isEmail = Model.Identifier.Contains('@');
}

<h1>Verifica tu cuenta</h1>
<p class="lead">Escribe el código de 6 dígitos que te enviamos. Vence en pocos minutos.</p>

@if (Model.Message is not null)
{
    <div class="alert alert-info" role="status">@Model.Message</div>
}

@if (Model.Error is not null)
{
    <div class="alert alert-error" role="alert">@Model.Error</div>
}

<div class="sent-to">
        <small>@(isEmail ? "Enviado al correo" : "Enviado por SMS al celular")</small>
        <strong>@Model.Identifier</strong>
</div>

<form method="post">
    <input type="hidden" asp-for="Identifier" />
    <input type="hidden" asp-for="ReturnUrl" />

    <div class="field">
        <label asp-for="Code">Código de verificación</label>
        <input asp-for="Code" class="input code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="••••••" autofocus />
    </div>

    <button type="submit" class="button">Verificar y continuar</button>
    <button type="submit" class="button-link" asp-page-handler="Resend">¿No te llegó? Enviar otro código</button>
</form>

<p class="switch">¿Escribiste mal el dato? <a asp-page="Register" asp-route-returnUrl="@Model.ReturnUrl">Vuelve a empezar</a></p>
