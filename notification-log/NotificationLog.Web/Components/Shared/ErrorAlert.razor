@if (Exception is not null)
{
    <div class="alert alert-danger d-flex align-items-start gap-2 shadow-sm" role="alert">
        <span class="alert-icon">⚠</span>
        <div class="flex-grow-1">
            <div class="fw-semibold">@(Exception.Title ?? "Ocurrió un error")</div>
            <div class="small">@Exception.Message</div>
            @if (Exception.FieldErrors is { Count: > 0 })
            {
                <ul class="mb-0 mt-1 small">
                    @foreach (var field in Exception.FieldErrors)
                    {
                        @foreach (var message in field.Value)
                        {
                            <li><strong>@field.Key:</strong> @message</li>
                        }
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public ApiException? Exception { get; set; }
}
