@code {
    private const string HypotheticalTestSnippet = """
[TestClass]
public class NotificationTriggerTests
{
    [TestMethod]
    public void AddConfiguration_SegundoCanalActivoIgual_LanzaDomainException()
    {
        var trigger = NotificationTrigger.Create(
            EventKey.Create("pedido.confirmado"), "Se confirmó un pedido");

        trigger.AddConfiguration(Guid.NewGuid(), NotificationChannel.Email);

        var act = () => trigger.AddConfiguration(Guid.NewGuid(), NotificationChannel.Email);

        Assert.ThrowsException<DomainException>(act);
        // ^ se lee como la propia regla de negocio: "no puede haber dos
        //   configuraciones activas del mismo canal". Cero mocks, cero base de datos.
    }
}
""";
}
