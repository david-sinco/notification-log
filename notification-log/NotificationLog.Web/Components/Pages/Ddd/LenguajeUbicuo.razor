        <text x="190" y="26" text-anchor="middle" font-size="12" font-weight="700" fill="#991b1b">Sin lenguaje ubicuo</text>
        <rect x="40" y="40" width="140" height="50" rx="8" fill="#fee2e2" stroke="#fecaca" />
        <text x="110" y="70" text-anchor="middle" font-size="11" fill="#991b1b">"el usuario está inactivo"</text>
        <line x1="180" y1="65" x2="230" y2="65" stroke="#dc2626" stroke-width="1.5" marker-end="url(#ulArrow)" />
        <text x="205" y="55" text-anchor="middle" font-size="9" fill="#dc2626">traduce</text>
