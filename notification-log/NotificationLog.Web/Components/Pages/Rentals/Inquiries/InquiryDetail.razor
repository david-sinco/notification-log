@page "/rentals/inquiries/{Id:guid}"
@implements IDisposable
@inject InquiriesApiClient Api
@inject RentalsActor Actor

<PageTitle>Consulta · NotificationLog</PageTitle>

<div class="mb-3">
    <a href="/rentals/inquiries" class="small">← Volver a consultas</a>
</div>

@if (loading && inquiry is null)
{
    <div class="p-5 text-center text-muted">Cargando…</div>
}
else if (loadError is not null)
{
    <ErrorAlert Exception="loadError" />
}
else if (inquiry is not null)
{
    <div class="page-header">
        <div>
            <h1>Consulta</h1>
            <p>
                Sobre <ShortId Value="inquiry.ListingId" Href="@($"/rentals/listings/{inquiry.ListingId}")" /> ·
                interesado <ShortId Value="inquiry.SeekerId" /> · abierta el @RentalsFormat.Date(inquiry.OpenedAt)
            </p>
        </div>
        <div>
            <StatusPill Text="@(inquiry.IsClosed ? "Cerrada" : "Abierta")" Variant="@(inquiry.IsClosed ? "neutral" : "success")" />
        </div>
    </div>

    @if (inquiry.ClosedReason is not null)
    {
        <div class="alert alert-info-soft small"><strong>Cerrada:</strong> @inquiry.ClosedReason</div>
    }

    <div class="surface-card mb-4">
        <div class="chat-thread">
            @foreach (var m in inquiry.Messages)
            {
                var fromSeeker = m.AuthorId == inquiry.SeekerId;
                <div class="chat-message @(fromSeeker ? "chat-seeker" : "")">
                    <div class="chat-meta">
                        @(fromSeeker ? "Interesado" : "Publicador o asesor") · <ShortId Value="m.AuthorId" /> · @RentalsFormat.Date(m.At)
                    </div>
                    <div style="white-space:pre-wrap">@m.Text</div>
                </div>
            }
        </div>
    </div>

    @if (!inquiry.IsClosed)
    {
        <div class="surface-card">
            <h2 class="h6">@(Actor.Is(inquiry.SeekerId) ? "Escribir como interesado" : "Responder como publicador o asesor")</h2>
            <textarea class="form-control mb-2" rows="3" maxlength="@InquiryLimits.MaxMessageLength" @bind="draft" @bind:event="oninput"></textarea>
            <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap">
                <span class="form-hint">No se permiten teléfonos, correos ni enlaces.</span>
                <button class="btn btn-primary" disabled="@(busy || string.IsNullOrWhiteSpace(draft))" @onclick="SendAsync">Enviar</button>
            </div>
            @if (actionError is not null)
            {
                <div class="mt-3"><ErrorAlert Exception="actionError" /></div>
            }
        </div>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private InquiryDto? inquiry;
    private bool loading = true;
    private ApiException? loadError;
    private ApiException? actionError;
    private bool busy;
    private string draft = "";

    protected override void OnInitialized() => Actor.Changed += OnActorChanged;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private void OnActorChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Actor.Changed -= OnActorChanged;

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            inquiry = await Api.GetByIdAsync(Id, CancellationToken.None);
            loadError = null;
        }
        catch (ApiException ex)
        {
            loadError = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SendAsync()
    {
        busy = true;
        try
        {
            var actorId = Actor.Require();

            if (actorId == inquiry!.SeekerId)
                await Api.SendMessageAsync(new SendInquiryMessageRequest(actorId, inquiry.ListingId, draft), CancellationToken.None);
            else
                await Api.ReplyAsync(Id, actorId, draft, CancellationToken.None);

            draft = "";
            actionError = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            actionError = ex;
        }
        finally
        {
            busy = false;
        }
    }
}
