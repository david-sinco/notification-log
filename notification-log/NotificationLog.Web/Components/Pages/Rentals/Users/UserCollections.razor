@page "/rentals/me"
@implements IDisposable
@inject UserCollectionsApiClient Api
@inject RentalsActor Actor
@inject NavigationManager Nav

<PageTitle>Favoritos y búsquedas · NotificationLog</PageTitle>

<div class="page-header">
    <div>
        <h1>Favoritos y búsquedas</h1>
        <p>Lo que guardó el usuario con el que estás actuando. Las alertas avisan de publicaciones nuevas que coinciden.</p>
    </div>
    <button class="btn btn-primary" disabled="@(Actor.Id is null)" @onclick="OpenCreate">+ Nueva búsqueda</button>
</div>

@if (Actor.Id is null)
{
    <EmptyState Text="Elegí un usuario en «Actuando como» para ver sus favoritos y búsquedas." Icon="👤" />
}
else
{
    @if (error is not null)
    {
        <ErrorAlert Exception="error" />
    }

    <div class="table-card mb-4">
        <div class="px-3 pt-3 pb-2"><h2 class="h6 mb-0">Búsquedas guardadas (@searches.Count/@SavedSearchLimits.MaxSearches)</h2></div>
        @if (loading)
        {
            <div class="p-4 text-center text-muted">Cargando…</div>
        }
        else if (searches.Count == 0)
        {
            <EmptyState Text="No hay búsquedas guardadas." Icon="🔎" />
        }
        else
        {
            <div class="table-responsive-wrap">
                <table class="table">
                    <thead><tr><th>Nombre</th><th>Criterios</th><th>Alertas</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in searches)
                        {
                            <tr>
                                <td class="fw-medium">@s.Name</td>
                                <td class="small">@Describe(s)</td>
                                <td>@RentalsFormat.Term(s.Frequency)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" disabled="@busy" @onclick="() => OpenEdit(s)">Editar</button>
                                        <button class="btn btn-outline-danger" disabled="@busy" @onclick="() => RunAsync(u => Api.DeleteSavedSearchAsync(u, s.Id, CancellationToken.None))">Eliminar</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="table-card">
        <div class="px-3 pt-3 pb-2"><h2 class="h6 mb-0">Favoritos (@favorites.Count)</h2></div>
        @if (!loading && favorites.Count == 0)
        {
            <EmptyState Text="No hay favoritos. Se agregan desde una publicación publicada." Icon="🤍" />
        }
        else if (!loading)
        {
            <div class="table-responsive-wrap">
                <table class="table">
                    <thead><tr><th>Inmueble</th><th>Precio</th><th>Estado</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var l in favorites)
                        {
                            <tr class="row-link" @onclick='() => Nav.NavigateTo($"/rentals/listings/{l.Id}")'>
                                <td>@RentalsFormat.ListingTitle(l.Type, l.Neighborhood, l.City)</td>
                                <td>@RentalsFormat.Money(l.Price)</td>
                                <td><RentalStatusPill Status="@l.Status" /></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-danger" disabled="@busy" @onclick:stopPropagation="true"
                                            @onclick="() => RunAsync(u => Api.RemoveFavoriteAsync(u, l.Id, CancellationToken.None))">
                                        Quitar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

<Modal Title="@(editingId is null ? "Nueva búsqueda" : "Editar búsqueda")" Large="true" @bind-IsVisible="showForm">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Nombre</label>
                <input class="form-control" maxlength="@SavedSearchLimits.MaxNameLength" @bind="form.Name" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Operación</label>
                <select class="form-select" @bind="form.Operation">
                    @foreach (var o in RentalsFormat.Values<Operation>())
                    {
                        <option value="@o">@RentalsFormat.Term(o)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Alertas</label>
                <select class="form-select" @bind="form.Frequency">
                    @foreach (var f in RentalsFormat.Values<AlertFrequency>())
                    {
                        <option value="@f">@RentalsFormat.Term(f)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Ciudad</label>
                <input class="form-control" @bind="form.City" />
            </div>
            <div class="col-md-8">
                <label class="form-label">Barrios</label>
                <input class="form-control" placeholder="Separados por coma; vacío = todos" @bind="form.Neighborhoods" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Precio mínimo</label>
                <input type="number" class="form-control" min="0" step="10000" @bind="form.MinPrice" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Precio máximo</label>
                <input type="number" class="form-control" min="0" step="10000" @bind="form.MaxPrice" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Hab. mín.</label>
                <input type="number" class="form-control" min="0" @bind="form.MinBedrooms" />
            </div>
            <div class="col-md-2">
                <label class="form-label">Estrato</label>
                <div class="d-flex gap-1">
                    <input type="number" class="form-control" min="1" max="6" placeholder="mín" @bind="form.MinStratum" />
                    <input type="number" class="form-control" min="1" max="6" placeholder="máx" @bind="form.MaxStratum" />
                </div>
            </div>
            <div class="col-md-2">
                <label class="form-label">Área mín.</label>
                <input type="number" class="form-control" min="1" @bind="form.MinArea" />
            </div>
        </div>
        <div class="form-hint mt-2">Las alertas solo se envían si el usuario dio consentimiento en Identidades.</div>
        @if (modalError is not null)
        {
            <div class="mt-3"><ErrorAlert Exception="modalError" /></div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showForm = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@modalBusy" @onclick="SaveAsync">Guardar</button>
    </FooterContent>
</Modal>

@code {
    private IReadOnlyList<SavedSearchDto> searches = [];
    private IReadOnlyList<ListingSummaryDto> favorites = [];
    private bool loading = true;
    private bool busy;
    private ApiException? error;

    private bool showForm;
    private bool modalBusy;
    private ApiException? modalError;
    private Guid? editingId;
    private SearchForm form = new();

    protected override Task OnInitializedAsync()
    {
        Actor.Changed += OnActorChanged;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (Actor.Id is not { } userId)
            return;

        loading = true;
        try
        {
            var searchesTask = Api.GetSavedSearchesAsync(userId, CancellationToken.None);
            var favoritesTask = Api.GetFavoritesAsync(userId, CancellationToken.None);
            await Task.WhenAll(searchesTask, favoritesTask);

            searches = searchesTask.Result;
            favorites = favoritesTask.Result;
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task RunAsync(Func<Guid, Task> action)
    {
        busy = true;
        try
        {
            await action(Actor.Require());
            error = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private static string Describe(SavedSearchDto s)
    {
        var parts = new List<string> { RentalsFormat.Term(s.Operation), s.City };

        if (s.Neighborhoods.Count > 0) parts.Add(string.Join(", ", s.Neighborhoods));
        if (s.MinPrice is not null || s.MaxPrice is not null) parts.Add($"{RentalsFormat.Money(s.MinPrice)} a {RentalsFormat.Money(s.MaxPrice)}");
        if (s.MinBedrooms is not null) parts.Add($"{s.MinBedrooms}+ hab");
        if (s.MinStratum is not null || s.MaxStratum is not null) parts.Add($"estrato {s.MinStratum?.ToString() ?? "1"}–{s.MaxStratum?.ToString() ?? "6"}");
        if (s.MinArea is not null) parts.Add($"{s.MinArea:0.#}+ m²");

        return string.Join(" · ", parts);
    }

    private void OpenCreate()
    {
        editingId = null;
        form = new SearchForm();
        modalError = null;
        showForm = true;
    }

    private void OpenEdit(SavedSearchDto s)
    {
        editingId = s.Id;
        form = SearchForm.From(s);
        modalError = null;
        showForm = true;
    }

    private async Task SaveAsync()
    {
        modalBusy = true;
        try
        {
            var userId = Actor.Require();

            if (editingId is { } searchId)
                await Api.UpdateSavedSearchAsync(userId, searchId, form.ToRequest(), CancellationToken.None);
            else
                await Api.CreateSavedSearchAsync(userId, form.ToRequest(), CancellationToken.None);

            showForm = false;
            modalError = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            modalError = ex;
        }
        finally
        {
            modalBusy = false;
        }
    }

    private void OnActorChanged() => InvokeAsync(async () =>
    {
        searches = [];
        favorites = [];
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Actor.Changed -= OnActorChanged;

    private sealed class SearchForm
    {
        public string Name { get; set; } = "";
        public Operation Operation { get; set; } = Operation.Rent;
        public AlertFrequency Frequency { get; set; } = AlertFrequency.Immediate;
        public string City { get; set; } = "";
        public string Neighborhoods { get; set; } = "";
        public long? MinPrice { get; set; }
        public long? MaxPrice { get; set; }
        public int? MinBedrooms { get; set; }
        public int? MinStratum { get; set; }
        public int? MaxStratum { get; set; }
        public decimal? MinArea { get; set; }

        public static SearchForm From(SavedSearchDto s) => new()
        {
            Name = s.Name,
            Operation = Enum.Parse<Operation>(s.Operation),
            Frequency = Enum.Parse<AlertFrequency>(s.Frequency),
            City = s.City,
            Neighborhoods = string.Join(", ", s.Neighborhoods),
            MinPrice = s.MinPrice,
            MaxPrice = s.MaxPrice,
            MinBedrooms = s.MinBedrooms,
            MinStratum = s.MinStratum,
            MaxStratum = s.MaxStratum,
            MinArea = s.MinArea
        };

        public SavedSearchRequest ToRequest() => new(
            Name,
            new SearchCriteriaRequest(
                Operation,
                City,
                Neighborhoods.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries),
                MinPrice,
                MaxPrice,
                MinBedrooms,
                MinStratum,
                MaxStratum,
                MinArea),
            Frequency);
    }
}
