@page "/rentals/identity"
@inject DevIdentityApiClient Api

<PageTitle>Identidades · NotificationLog</PageTitle>

<div class="page-header">
    <div>
        <h1>Identidades (dev)</h1>
        <p>
            Réplica local de Identity que usa Arriendos para decidir permisos y verificaciones. Mientras no exista el
            productor real, se carga desde acá.
        </p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" @onclick="OpenPerson">+ Persona</button>
        <button class="btn btn-outline-secondary" @onclick="OpenAdvisor">+ Asesor</button>
    </div>
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

<div class="table-card mb-4">
    <div class="px-3 pt-3 pb-2"><h2 class="h6 mb-0">Personas (@(identity?.People.Count ?? 0))</h2></div>
    @if (loading)
    {
        <div class="p-4 text-center text-muted">Cargando…</div>
    }
    else if (identity is { People.Count: 0 })
    {
        <EmptyState Text="No hay personas. Creá al menos un propietario y un interesado." Icon="👥" />
    }
    else if (identity is not null)
    {
        <div class="table-responsive-wrap">
            <table class="table">
                <thead>
                    <tr><th>Persona</th><th>Usuario</th><th>Teléfono</th><th>Documento</th><th>Alertas</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var p in identity.People)
                    {
                        <tr>
                            <td><ShortId Value="p.Id" /></td>
                            <td>
                                @if (p.UserId is { } userId)
                                {
                                    <ShortId Value="userId" />
                                }
                                else
                                {
                                    <span class="text-muted">Sin usuario</span>
                                }
                            </td>
                            <td><StatusPill Text="@(p.IsPhoneVerified ? "Verificado" : "Sin verificar")" Variant="@(p.IsPhoneVerified ? "success" : "neutral")" /></td>
                            <td><StatusPill Text="@(p.IsDocumentVerified ? "Verificado" : "Sin verificar")" Variant="@(p.IsDocumentVerified ? "success" : "neutral")" /></td>
                            <td>
                                @if (p.UserId is { } consentUser)
                                {
                                    var granted = HasConsent(consentUser);
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@busy"
                                            @onclick="() => RunAsync(() => Api.SetAlertsConsentAsync(consentUser, !granted, CancellationToken.None))">
                                        @(granted ? "Acepta · revocar" : "No acepta · otorgar")
                                    </button>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="() => OpenPerson(p)">Editar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<div class="table-card">
    <div class="px-3 pt-3 pb-2"><h2 class="h6 mb-0">Asesores (@(identity?.Advisors.Count ?? 0))</h2></div>
    @if (identity is { Advisors.Count: 0 })
    {
        <EmptyState Text="No hay asesores." Icon="🧑‍💼" />
    }
    else if (identity is not null)
    {
        <div class="table-responsive-wrap">
            <table class="table">
                <thead><tr><th>Asesor</th><th>Ciudades</th><th>Capacidad</th><th>Estado</th><th></th></tr></thead>
                <tbody>
                    @foreach (var a in identity.Advisors)
                    {
                        <tr>
                            <td><ShortId Value="a.Id" /></td>
                            <td>@string.Join(", ", a.ServiceCities)</td>
                            <td>@a.Capacity</td>
                            <td><StatusPill Text="@(a.IsActive ? "Activo" : "Inactivo")" Variant="@(a.IsActive ? "success" : "neutral")" /></td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-secondary" @onclick="() => OpenAdvisor(a)">Editar</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<Modal Title="Persona" @bind-IsVisible="showPerson">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">Identificador de persona</label>
            <input class="form-control font-monospace" @bind="personId" disabled="@editingPerson" />
        </div>
        <div class="mb-3">
            <label class="form-label">Identificador de usuario</label>
            <input class="form-control font-monospace" @bind="personUserId" placeholder="Vacío = persona sin usuario" />
            <div class="form-hint">El usuario es quien actúa en la plataforma; la persona es el propietario de las publicaciones.</div>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="phone" @bind="personPhone" />
            <label class="form-check-label" for="phone">Teléfono verificado (necesario para visitas y consultas)</label>
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="document" @bind="personDocument" />
            <label class="form-check-label" for="document">Documento verificado (necesario para ofertar)</label>
        </div>
        @if (modalError is not null)
        {
            <div class="mt-3"><ErrorAlert Exception="modalError" /></div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showPerson = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(modalBusy || !Guid.TryParse(personId, out _))" @onclick="SavePersonAsync">Guardar</button>
    </FooterContent>
</Modal>

<Modal Title="Asesor" @bind-IsVisible="showAdvisor">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label">Identificador del asesor</label>
            <input class="form-control font-monospace" @bind="advisorId" disabled="@editingAdvisor" />
        </div>
        <div class="mb-3">
            <label class="form-label">Ciudades donde atiende</label>
            <input class="form-control" placeholder="Separadas por coma" @bind="advisorCities" />
        </div>
        <div class="mb-3">
            <label class="form-label">Capacidad (publicaciones activas)</label>
            <input type="number" class="form-control" min="0" @bind="advisorCapacity" />
        </div>
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="advisor-active" @bind="advisorActive" />
            <label class="form-check-label" for="advisor-active">Activo</label>
        </div>
        @if (modalError is not null)
        {
            <div class="mt-3"><ErrorAlert Exception="modalError" /></div>
        }
    </ChildContent>
    <FooterContent>
        <button type="button" class="btn btn-outline-secondary" @onclick="() => showAdvisor = false">Cancelar</button>
        <button type="button" class="btn btn-primary" disabled="@(modalBusy || !Guid.TryParse(advisorId, out _))" @onclick="SaveAdvisorAsync">Guardar</button>
    </FooterContent>
</Modal>

@code {
    private IdentitySnapshotDto? identity;
    private bool loading = true;
    private bool busy;
    private ApiException? error;

    private bool modalBusy;
    private ApiException? modalError;

    private bool showPerson;
    private bool editingPerson;
    private string personId = "";
    private string personUserId = "";
    private bool personPhone;
    private bool personDocument;

    private bool showAdvisor;
    private bool editingAdvisor;
    private string advisorId = "";
    private string advisorCities = "";
    private int advisorCapacity;
    private bool advisorActive;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            identity = await Api.GetAsync(CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private bool HasConsent(Guid userId) => identity!.AlertsConsents.Any(c => c.Id == userId && c.IsGranted);

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        try
        {
            await action();
            error = null;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenPerson() => OpenPerson(new PersonDto(Guid.NewGuid(), Guid.NewGuid(), true, true), editing: false);

    private void OpenPerson(PersonDto person) => OpenPerson(person, editing: true);

    private void OpenPerson(PersonDto person, bool editing)
    {
        editingPerson = editing;
        personId = person.Id.ToString();
        personUserId = person.UserId?.ToString() ?? "";
        personPhone = person.IsPhoneVerified;
        personDocument = person.IsDocumentVerified;
        modalError = null;
        showPerson = true;
    }

    private async Task SavePersonAsync()
    {
        modalBusy = true;
        try
        {
            Guid? userId = Guid.TryParse(personUserId, out var parsed) ? parsed : null;
            await Api.SetPersonAsync(Guid.Parse(personId), new SetPersonRequest(userId, personPhone, personDocument), CancellationToken.None);
            showPerson = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            modalError = ex;
        }
        finally
        {
            modalBusy = false;
        }
    }

    private void OpenAdvisor() => OpenAdvisor(new AdvisorDto(Guid.NewGuid(), true, ["Bogotá"], 20), editing: false);

    private void OpenAdvisor(AdvisorDto advisor) => OpenAdvisor(advisor, editing: true);

    private void OpenAdvisor(AdvisorDto advisor, bool editing)
    {
        editingAdvisor = editing;
        advisorId = advisor.Id.ToString();
        advisorCities = string.Join(", ", advisor.ServiceCities);
        advisorCapacity = advisor.Capacity;
        advisorActive = advisor.IsActive;
        modalError = null;
        showAdvisor = true;
    }

    private async Task SaveAdvisorAsync()
    {
        modalBusy = true;
        try
        {
            var cities = advisorCities.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            await Api.SetAdvisorAsync(Guid.Parse(advisorId), new SetAdvisorRequest(advisorActive, cities, advisorCapacity), CancellationToken.None);
            showAdvisor = false;
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            modalError = ex;
        }
        finally
        {
            modalBusy = false;
        }
    }
}
