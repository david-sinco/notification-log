@code {
    private const string RepoSnippet = """
internal sealed class NotificationTriggerRepository(NotificationDbContext db) : INotificationTriggerRepository
{
    public Task<NotificationTrigger?> GetByEventKeyAsync(EventKey eventKey, CancellationToken ct)
        => _db.Triggers
            .Include(t => t.Configurations)
            .SingleOrDefaultAsync(t => t.EventKey == eventKey, ct);

    public Task<bool> ExistsAsync(EventKey eventKey, CancellationToken ct)
        => _db.Triggers.AnyAsync(t => t.EventKey == eventKey, ct);

    // ListAsync pagina y filtra con EF.Functions.Like — nada de esto se filtra hacia Domain.
}
""";

    private const string DbContextSnippet = """
public sealed class NotificationDbContext(DbContextOptions<NotificationDbContext> options)
    : DbContext(options), IUnitOfWork
{
    public DbSet<NotificationTrigger> Triggers => Set<NotificationTrigger>();
    public DbSet<NotificationTemplate> Templates => Set<NotificationTemplate>();
    public DbSet<Recipient> Recipients => Set<Recipient>();
    public DbSet<Notification> Notifications => Set<Notification>();

    protected override void OnModelCreating(ModelBuilder modelBuilder)
        => modelBuilder.ApplyConfigurationsFromAssembly(typeof(NotificationDbContext).Assembly);
}

// DependencyInjection.cs:
services.AddScoped<IUnitOfWork>(sp => sp.GetRequiredService<NotificationDbContext>());
""";

    private const string ConfigSnippet = """
builder.Property(t => t.EventKey)
    .HasConversion(
        key => key.Value,
        value => EventKey.Create(value))
    .HasColumnName("EventKey")
    .HasMaxLength(EventKey.MaxLength)     // <- misma constante que usa el validador de Application
    .IsUnicode(false)
    .IsRequired();

builder.HasIndex(t => t.EventKey)
    .IsUnique()
    .HasDatabaseName("UX_NotificationTriggers_EventKey");
""";

    private const string RabbitSnippet = """
services.AddWolverine(opts =>
{
    opts.UseRabbitMq(new Uri(connectionString)).AutoProvision();

    opts.UseProtobufSerialization();
    opts.AddSerializer(new SystemTextJsonSerializer(
        new JsonSerializerOptions(JsonSerializerDefaults.Web)));

    opts.ListenToRabbitQueue("user-changes")
        .DefaultIncomingMessage<UserContactUpdated>();
});
""";

    private const string HandlerSnippet = """
public static class UserContactUpdatedHandler
{
    // Wolverine descubre este método por convención (Handle) y lo invoca por cada mensaje —
    // no hace falta registrar ni implementar una interfaz de "consumer".
    public static Task Handle(UserContactUpdated message, RecipientSyncService syncService, CancellationToken ct)
    {
        var change = MapToUserChange(message); // Protobuf -> tipo propio de Application
        return syncService.HandleAsync(change, ct);
    }
}
""";

    private const string DiCommentSnippet = """
// Ejemplo de mensajería con RabbitMQ (Messaging/RabbitMq): consume UserChange y llama a
// RecipientSyncService. Cuando se integre Kafka, este llamado se reemplaza por el
// equivalente en Messaging/Kafka sin tocar Application.
services.AddRabbitMqMessaging(configuration);
""";
}
