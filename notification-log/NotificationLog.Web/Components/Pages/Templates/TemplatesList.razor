@page "/templates"
@inject TemplatesApiClient Api
@inject NavigationManager Nav

<PageTitle>Plantillas · NotificationLog</PageTitle>

<div class="page-header">
    <div>
        <h1>Plantillas</h1>
        <p>Contenido de las notificaciones, versionado por canal.</p>
    </div>
    <a class="btn btn-primary" href="/templates/new">+ Nueva plantilla</a>
</div>

@if (error is not null)
{
    <ErrorAlert Exception="error" />
}

<div class="filter-bar">
    <div class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Buscar</label>
            <input class="form-control" placeholder="Nombre… (Enter para buscar)"
                   @bind="search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Canal</label>
            <select class="form-select" @bind="channelFilter" @bind:after="RefreshAsync">
                <option value="">Todos</option>
                <option value="Email">Email</option>
                <option value="Sms">SMS</option>
                <option value="Push">Push</option>
                <option value="WhatsApp">WhatsApp</option>
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Estado</label>
            <select class="form-select" @bind="statusFilter" @bind:after="RefreshAsync">
                <option value="">Todos</option>
                <option value="true">Habilitadas</option>
                <option value="false">Deshabilitadas</option>
            </select>
        </div>
        <div class="col-md-2 text-md-end">
            <button class="btn btn-outline-secondary w-100" @onclick="RefreshAsync">Filtrar</button>
        </div>
    </div>
</div>

<div class="table-card">
    @if (loading)
    {
        <div class="p-4 text-center text-muted">Cargando…</div>
    }
    else if (page is { Items.Count: 0 })
    {
        <EmptyState Text="No se encontraron plantillas." Icon="📄" />
    }
    else if (page is not null)
    {
        <div class="table-responsive-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Canal</th>
                        <th>Versión actual</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in page.Items)
                    {
                        <tr class="row-link" @onclick='() => Nav.NavigateTo($"/templates/{t.Id}")'>
                            <td>@t.Name</td>
                            <td><ChannelBadge Channel="@t.Channel" /></td>
                            <td>v@(t.CurrentVersion)</td>
                            <td>
                                <StatusPill Text="@(t.IsEnabled ? "Habilitada" : "Deshabilitada")"
                                            Variant="@(t.IsEnabled ? "success" : "neutral")" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="px-3 pb-3">
            <Pager Page="page.Page" TotalPages="page.TotalPages" TotalCount="page.TotalCount" OnPageChange="GoToPage" />
        </div>
    }
</div>

@code {
    private PagedResult<TemplateSummaryDto>? page;
    private bool loading = true;
    private ApiException? error;

    private string search = "";
    private string channelFilter = "";
    private string statusFilter = "";
    private int currentPage = 1;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            NotificationChannel? channel = string.IsNullOrEmpty(channelFilter)
                ? null
                : Enum.Parse<NotificationChannel>(channelFilter);
            bool? isEnabled = statusFilter switch { "true" => true, "false" => false, _ => null };

            page = await Api.ListAsync(
                string.IsNullOrWhiteSpace(search) ? null : search, channel, isEnabled, currentPage, 10, CancellationToken.None);
            error = null;
        }
        catch (ApiException ex)
        {
            error = ex;
        }
        finally
        {
            loading = false;
        }
    }

    private Task RefreshAsync()
    {
        currentPage = 1;
        return LoadAsync();
    }

    private Task GoToPage(int p)
    {
        currentPage = p;
        return LoadAsync();
    }

    private Task OnSearchKeyUp(KeyboardEventArgs e) => e.Key == "Enter" ? RefreshAsync() : Task.CompletedTask;
}
