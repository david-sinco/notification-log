@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">
            <span class="brand-mark">N</span> NotificationLog
        </a>
    </div>
</div>

<input type="checkbox" title="Menú de navegación" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Panel
            </NavLink>
        </div>

        <details class="nav-group px-3" open="@(!IsRentalsRoute)">
            <summary class="nav-group-title" onclick="event.stopPropagation()">Notificaciones</summary>

            <div class="nav-item">
                <NavLink class="nav-link" href="triggers">
                    <span class="bi bi-lightning-fill" aria-hidden="true"></span> Triggers
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="templates">
                    <span class="bi bi-file-text-fill" aria-hidden="true"></span> Plantillas
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="recipients">
                    <span class="bi bi-people-fill" aria-hidden="true"></span> Destinatarios
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="notifications">
                    <span class="bi bi-bell-fill" aria-hidden="true"></span> Notificaciones
                </NavLink>
            </div>
        </details>

        <details class="nav-group px-3" open="@IsRentalsRoute">
            <summary class="nav-group-title" onclick="event.stopPropagation()">Arriendos</summary>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals" Match="NavLinkMatch.All">
                    <span class="bi bi-grid-fill" aria-hidden="true"></span> Resumen
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/listings">
                    <span class="bi bi-building-fill" aria-hidden="true"></span> Publicaciones
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/moderation">
                    <span class="bi bi-shield-fill" aria-hidden="true"></span> Moderación
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/visits">
                    <span class="bi bi-calendar-fill" aria-hidden="true"></span> Visitas
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/offers">
                    <span class="bi bi-tag-fill" aria-hidden="true"></span> Ofertas
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/inquiries">
                    <span class="bi bi-chat-fill" aria-hidden="true"></span> Consultas
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/me">
                    <span class="bi bi-heart-fill" aria-hidden="true"></span> Favoritos y búsquedas
                </NavLink>
            </div>

            <div class="nav-item">
                <NavLink class="nav-link" href="rentals/identity">
                    <span class="bi bi-person-fill" aria-hidden="true"></span> Identidades (dev)
                </NavLink>
            </div>
        </details>

        <div class="nav-item px-3 nav-item-separated">
            <NavLink class="nav-link" href="proyecto">
                <span aria-hidden="true">🧭</span> Cómo funciona
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ddd">
                <span aria-hidden="true">📘</span> Aprende DDD
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="arquitectura">
                <span aria-hidden="true">🏗️</span> Arquitectura
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="patrones">
                <span aria-hidden="true">🧱</span> Patrones
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool IsRentalsRoute => Nav.ToBaseRelativePath(Nav.Uri).StartsWith("rentals", StringComparison.OrdinalIgnoreCase);
}
